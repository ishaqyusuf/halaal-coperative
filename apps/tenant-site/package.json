{
  "name": "@halaal-vest/tenant-site",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "node ../../scripts/with-workspace-env.mjs PORTLESS_APP_PORT=${PORTLESS_APP_PORT:-1443} TZ=UTC portless tenant.halaal-vest next dev --turbopack",
    "dev:portless": "node ../../scripts/with-workspace-env.mjs portless tenant.halaal-vest next dev --turbopack",
    "build": "node ../../scripts/with-workspace-env.mjs next build --webpack",
    "start": "node ../../scripts/with-workspace-env.mjs next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@halaal-vest/auth": "workspace:*",
    "@halaal-vest/db": "workspace:*",
    "@halaal-vest/domain": "workspace:*",
    "@halaal-vest/notifications-react": "workspace:*",
    "@halaal-vest/ui": "workspace:*",
    "@halaal-vest/utils": "workspace:*",
    "next": "16.1.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^25.1.0",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@halaal-vest/eslint-config": "workspace:^",
    "@halaal-vest/tsconfig": "workspace:*",
    "eslint": "^9.39.2",
    "typescript": "^5.9.3"
  }
}
