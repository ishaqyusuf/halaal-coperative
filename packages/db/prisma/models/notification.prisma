model NotificationOutbox {
  id                 String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String?                    @map("tenant_id") @db.Uuid
  notificationType   String                     @map("notification_type")
  channel            String                     @default("email")
  recipient          String
  subject            String
  bodyText           String                     @map("body_text")
  actionLabel        String                     @map("action_label")
  actionUrl          String                     @map("action_url")
  source             String
  messageId          String?                    @map("message_id")
  status             NotificationDeliveryStatus @default(queued)
  attempts           Int                        @default(0)
  errorMessage       String?                    @map("error_message")
  metadata           Json?
  sentAt             DateTime?                  @map("sent_at") @db.Timestamptz(6)
  createdAt          DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant             Tenant?                    @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([tenantId, status, createdAt], map: "notification_outbox_tenant_status_created_at_idx")
  @@index([recipient, createdAt], map: "notification_outbox_recipient_created_at_idx")
  @@index([notificationType, createdAt], map: "notification_outbox_type_created_at_idx")
  @@map("notification_outbox")
}

model NotificationPreference {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  role               String?
  notificationType   String    @map("notification_type")
  channel            String    @default("email")
  enabled            Boolean   @default(true)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant             Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, role, notificationType, channel], map: "notification_preferences_tenant_role_type_channel_key")
  @@index([tenantId, role], map: "notification_preferences_tenant_role_idx")
  @@map("notification_preferences")
}
