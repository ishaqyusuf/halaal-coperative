// Cooperative assistant (plan: .brain/plans/2026-11-13-cooperative-assistant.md).
// Chats, drafts and channel links are separated by tenant, user, membership
// and channel. Membership is rechecked live on every read, edit, confirm and
// delivery, so it is stored as an id rather than a cascading relation.

model AssistantConversation {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String           @map("tenant_id") @db.Uuid
  userId        String           @map("user_id") @db.Uuid
  membershipId  String           @map("membership_id") @db.Uuid
  channel       AssistantChannel
  title         String           @default("New chat")
  lastMessageAt DateTime         @default(now()) @map("last_message_at") @db.Timestamptz(6)
  archivedAt    DateTime?        @map("archived_at") @db.Timestamptz(6)
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant    Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User                @relation("AssistantConversationOwner", fields: [userId], references: [id], onDelete: Cascade)
  messages  AssistantMessage[]
  turns     AssistantTurn[]
  proposals AssistantProposal[]

  @@index([tenantId, userId, membershipId, channel, lastMessageAt], map: "assistant_conversations_owner_recent_idx")
  @@map("assistant_conversations")
}

model AssistantMessage {
  id             String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String               @map("tenant_id") @db.Uuid
  conversationId String               @map("conversation_id") @db.Uuid
  role           AssistantMessageRole
  /// Typed parts from @halaalvest/assistant/contracts (text, answer, proposal ref, result).
  parts          Json
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  conversation AssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt], map: "assistant_messages_conversation_created_idx")
  @@map("assistant_messages")
}

/// One user message → one reply. `requestId` makes a replayed send return the saved reply.
model AssistantTurn {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String              @map("tenant_id") @db.Uuid
  conversationId     String              @map("conversation_id") @db.Uuid
  requestId          String              @map("request_id")
  status             AssistantTurnStatus @default(running)
  capabilityId       String?             @map("capability_id")
  userMessageId      String?             @map("user_message_id") @db.Uuid
  replyMessageId     String?             @map("reply_message_id") @db.Uuid
  provider           String?
  model              String?
  errorCode          String?             @map("error_code")
  durationMs         Int?                @map("duration_ms")
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt        DateTime?           @map("completed_at") @db.Timestamptz(6)

  conversation AssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, requestId], map: "assistant_turns_conversation_request_key")
  @@index([conversationId, status], map: "assistant_turns_conversation_status_idx")
  @@map("assistant_turns")
}

/// Exact-draft state machine: collect → review → confirm exact revision → saved result.
model AssistantProposal {
  id                String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String                  @map("tenant_id") @db.Uuid
  conversationId    String                  @map("conversation_id") @db.Uuid
  actorUserId       String                  @map("actor_user_id") @db.Uuid
  membershipId      String                  @map("membership_id") @db.Uuid
  capabilityId      String                  @map("capability_id")
  kind              String
  revision          Int                     @default(1)
  status            AssistantProposalStatus @default(collecting)
  /// Server-owned fields; an edit bumps `revision` and invalidates the old review.
  fields            Json
  expiresAt         DateTime                @map("expires_at") @db.Timestamptz(6)
  /// Idempotency key of the confirming write; one saved result per proposal.
  confirmationKey   String?                 @unique @map("confirmation_key")
  confirmedRevision Int?                    @map("confirmed_revision")
  /// Saved AssistantActionResult, returned again on a retried confirm.
  result            Json?
  resultReference   String?                 @map("result_reference")
  createdAt         DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)

  conversation AssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([tenantId, actorUserId, status], map: "assistant_proposals_actor_status_idx")
  @@index([conversationId, createdAt], map: "assistant_proposals_conversation_created_idx")
  @@map("assistant_proposals")
}

/// Short-lived, single-use link challenge. Only the nonce digest is stored.
model AssistantChannelChallenge {
  id                    String                          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId              String                          @map("tenant_id") @db.Uuid
  userId                String                          @map("user_id") @db.Uuid
  membershipId          String                          @map("membership_id") @db.Uuid
  provider              AssistantChannel
  nonceDigest           String                          @unique @map("nonce_digest")
  status                AssistantChannelChallengeStatus @default(issued)
  /// Set at claim: digest + masked form of the provider account that claimed it.
  providerAccountDigest String?                         @map("provider_account_digest")
  providerAccountMasked String?                         @map("provider_account_masked")
  providerChatId        String?                         @map("provider_chat_id")
  expiresAt             DateTime                        @map("expires_at") @db.Timestamptz(6)
  claimedAt             DateTime?                       @map("claimed_at") @db.Timestamptz(6)
  confirmedAt           DateTime?                       @map("confirmed_at") @db.Timestamptz(6)
  createdAt             DateTime                        @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, provider, status], map: "assistant_channel_challenges_owner_idx")
  @@map("assistant_channel_challenges")
}

/// One active tenant/membership per provider account at launch; relinking revokes the old link.
model AssistantChannelLink {
  id                    String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId              String                     @map("tenant_id") @db.Uuid
  userId                String                     @map("user_id") @db.Uuid
  membershipId          String                     @map("membership_id") @db.Uuid
  provider              AssistantChannel
  providerAccountDigest String                     @map("provider_account_digest")
  providerAccountMasked String                     @map("provider_account_masked")
  providerChatId        String                     @map("provider_chat_id")
  conversationId        String?                    @map("conversation_id") @db.Uuid
  status                AssistantChannelLinkStatus @default(active)
  confirmedAt           DateTime                   @default(now()) @map("confirmed_at") @db.Timestamptz(6)
  revokedAt             DateTime?                  @map("revoked_at") @db.Timestamptz(6)
  createdAt             DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  inbox  AssistantChannelInbox[]
  outbox AssistantChannelOutbox[]

  @@index([provider, providerAccountDigest, status], map: "assistant_channel_links_account_status_idx")
  @@index([tenantId, userId, provider, status], map: "assistant_channel_links_owner_idx")
  @@map("assistant_channel_links")
}

/// Durable ingress. Unique per environment/provider/endpoint/event so retries dedupe.
model AssistantChannelInbox {
  id           String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  environment  String
  provider     AssistantChannel
  endpointId   String                     @map("endpoint_id")
  eventId      String                     @map("event_id")
  providerChatId String                   @map("provider_chat_id")
  linkId       String?                    @map("link_id") @db.Uuid
  /// Minimal normalized message (text/command/callback); never raw media or secrets.
  payload      Json
  state        AssistantChannelInboxState @default(received)
  attempts     Int                        @default(0)
  errorCode    String?                    @map("error_code")
  createdAt    DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  processedAt  DateTime?                  @map("processed_at") @db.Timestamptz(6)

  link   AssistantChannelLink?    @relation(fields: [linkId], references: [id], onDelete: SetNull)
  outbox AssistantChannelOutbox[]

  @@unique([environment, provider, endpointId, eventId], map: "assistant_channel_inbox_event_key")
  @@index([provider, providerChatId, state, createdAt], map: "assistant_channel_inbox_chat_state_idx")
  @@map("assistant_channel_inbox")
}

/// Durable delivery. The payload is recorded before sending so a retry never reruns the action.
model AssistantChannelOutbox {
  id                String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider          AssistantChannel
  providerChatId    String                      @map("provider_chat_id")
  linkId            String?                     @map("link_id") @db.Uuid
  inboxId           String?                     @map("inbox_id") @db.Uuid
  sequence          Int                         @default(0)
  payload           Json
  state             AssistantChannelOutboxState @default(pending)
  attempts          Int                         @default(0)
  providerMessageId String?                     @map("provider_message_id")
  errorCode         String?                     @map("error_code")
  createdAt         DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  sentAt            DateTime?                   @map("sent_at") @db.Timestamptz(6)

  link  AssistantChannelLink?  @relation(fields: [linkId], references: [id], onDelete: SetNull)
  inbox AssistantChannelInbox? @relation(fields: [inboxId], references: [id], onDelete: SetNull)

  @@unique([inboxId, sequence], map: "assistant_channel_outbox_inbox_sequence_key")
  @@index([state, createdAt], map: "assistant_channel_outbox_state_idx")
  @@map("assistant_channel_outbox")
}
