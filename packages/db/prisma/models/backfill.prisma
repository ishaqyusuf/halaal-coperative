model TenantShareStructureVersion {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String         @map("tenant_id") @db.Uuid
  effectiveFrom   DateTime       @map("effective_from") @db.Date
  amount          Decimal        @db.Decimal(18, 2)
  valueType       ShareValueType @default(fixed_amount) @map("value_type")
  basis           ShareBasis     @default(after_charge_deductions)
  notes           String?
  createdByUserId String?        @map("created_by_user_id") @db.Uuid
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, effectiveFrom], map: "tenant_share_versions_tenant_effective_key")
  @@index([tenantId, effectiveFrom], map: "tenant_share_versions_tenant_effective_idx")
  @@map("tenant_share_structure_versions")
}

model MemberShareOverride {
