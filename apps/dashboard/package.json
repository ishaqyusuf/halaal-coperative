{
  "name": "@halaalvest/dashboard",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "node ../../scripts/with-workspace-env.mjs PORTLESS_APP_PORT=${PORTLESS_APP_PORT:-1441} TZ=UTC portless app.halaalvest next dev --turbopack",
    "dev:portless": "node ../../scripts/with-workspace-env.mjs portless app.halaalvest next dev --turbopack",
    "build": "node ../../scripts/with-workspace-env.mjs next build --webpack",
    "start": "node ../../scripts/with-workspace-env.mjs next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@halaalvest/api": "workspace:*",
    "@halaalvest/auth": "workspace:*",
    "@halaalvest/backfill": "workspace:*",
    "@halaalvest/db": "workspace:*",
    "@halaalvest/domain": "workspace:*",
    "@halaalvest/jobs": "workspace:*",
    "@halaalvest/notifications": "workspace:*",
    "@halaalvest/notifications-react": "workspace:*",
    "@halaalvest/site-nav": "workspace:*",
    "@halaalvest/tenant-url": "workspace:*",
    "@halaalvest/ui": "workspace:*",
    "@halaalvest/utils": "workspace:*",
    "@hugeicons/core-free-icons": "^4.1.1",
    "@hugeicons/react": "^1.1.6",
    "@tanstack/react-query": "^5.100.14",
    "@tanstack/react-table": "^8.21.3",
    "@trpc/client": "^11.18.0",
    "@trpc/server": "^11.18.0",
    "@trpc/tanstack-react-query": "^11.18.0",
    "clsx": "^2.1.1",
    "next": "16.1.6",
    "next-themes": "^0.4.6",
    "nuqs": "^2.7.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "superjson": "^2.2.2",
    "tailwind-merge": "^3.6.0",
    "xlsx": "^0.18.5",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@halaalvest/eslint-config": "workspace:^",
    "@halaalvest/tsconfig": "workspace:*",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/bun": "^1.3.14",
    "@types/node": "^25.1.0",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.2",
    "typescript": "^5.9.3"
  }
}
