model MemberOnboardingRequest {
  id                 String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String                 @map("tenant_id") @db.Uuid
  userId             String                 @unique @map("user_id") @db.Uuid
  memberNumber       String                 @map("member_number")
  fullName           String                 @map("full_name")
  email              String
  phoneNumber        String?                @map("phone_number")
  status             MemberOnboardingStatus @default(pending_email_verification)
  emailVerifiedAt    DateTime?              @map("email_verified_at") @db.Timestamptz(6)
  approvedAt         DateTime?              @map("approved_at") @db.Timestamptz(6)
  approvedByUserId   String?                @map("approved_by_user_id") @db.Uuid
  rejectedAt         DateTime?              @map("rejected_at") @db.Timestamptz(6)
  rejectionReason    String?                @map("rejection_reason")
  createdAt          DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant             Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user               User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email], map: "member_onboarding_requests_tenant_email_key")
  @@unique([tenantId, memberNumber], map: "member_onboarding_requests_tenant_member_number_key")
  @@index([tenantId, status, createdAt], map: "member_onboarding_requests_tenant_status_created_at_idx")
  @@index([tenantId, emailVerifiedAt], map: "member_onboarding_requests_tenant_verified_at_idx")
  @@map("member_onboarding_requests")
}
