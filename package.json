{
  "name": "halaalvest",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "bun --env-file=/dev/null scripts/local-infra-command.ts with-env --mode prod -- turbo build",
    "db:docker:down": "docker compose -f docker-compose.yml down",
    "db:docker:up": "bun run dev:services:local",
    "db:generate": "bun --env-file=/dev/null ../local-infra-kit/bin/db.ts generate --profile halaalvest",
    "db:migrate": "bun --env-file=/dev/null ../local-infra-kit/bin/db.ts migrate --profile halaalvest",
    "db:pull": "bun --env-file=/dev/null ../local-infra-kit/bin/db.ts pull --profile halaalvest",
    "db:push": "bun --env-file=/dev/null ../local-infra-kit/bin/db.ts push --profile halaalvest",
    "db:shell": "bun --env-file=/dev/null ../local-infra-kit/bin/db.ts shell --profile halaalvest",
    "db:start": "bun run dev:services:local",
    "db:studio": "bun --env-file=/dev/null ../local-infra-kit/bin/db.ts studio --profile halaalvest",
    "dev": "bun --env-file=/dev/null scripts/local-infra-command.ts dev",
    "dev:prepare": "bun run kill:ports && bun run dev:services",
    "dev:services": "bun --env-file=/dev/null scripts/local-infra-command.ts dev-services",
    "dev:services:local": "bun --env-file=/dev/null scripts/local-infra-command.ts dev-services --mode local",
    "dev:services:local-db": "bun --env-file=/dev/null scripts/local-infra-command.ts dev-services --mode local",
    "eas-build:dev": "bun --env-file=/dev/null ./scripts/eas-account-runner.ts eas-build:dev",
    "eas-build:preview": "bun --env-file=/dev/null ./scripts/eas-account-runner.ts eas-build:preview",
    "eas-update:preview": "bun --env-file=/dev/null ./scripts/eas-account-runner.ts update:preview",
    "jobs:deploy": "bun run --filter @halaalvest/jobs deploy",
    "kill:ports": "bun --env-file=/dev/null ../local-infra-kit/bin/kill-ports.ts --profile halaalvest",
    "lint": "turbo lint",
    "lint:mobile": "turbo lint --filter=@halaalvest/mobile",
    "format": "turbo format",
    "terminal": "bash ./scripts/open-bun-script-terminal.sh",
    "typecheck": "turbo typecheck",
    "typecheck:mobile": "turbo typecheck --filter=@halaalvest/mobile",
    "test": "turbo test"
  },
  "devDependencies": {
    "@halaalvest/eslint-config": "workspace:*",
    "@halaalvest/tsconfig": "workspace:*",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "turbo": "^2.8.17",
    "typescript": "5.9.3"
  },
  "packageManager": "bun@1.3.0",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "lightningcss": "1.30.1"
  }
}
