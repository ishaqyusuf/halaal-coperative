{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    // "strict": true,
    // "module": "ESNext",
    // "forceConsistentCasingInFileNames": true,

    "baseUrl": ".",

    "strict": true,
    "noImplicitAny": false,

    "jsx": "react-native",
    "checkJs": false,

    "paths": {
      "@/*": ["./src/*"],
      "@halaalvest/api/trpc/routers/_app": ["./src/types/api-router.ts"],
      "@root/*": ["./*"],
      "@store/*": ["./src/store/*"],
      "@utils/*": ["./src/utils/*"],
      "@components/*": ["./src/components/*"],
      "@notifications/*": ["../../packages/notifications/src/*"],
      "@assets/*": ["./assets/*"],
      "@hooks/*": ["./src/hooks/*"],
      "@types/*": ["./src/types/*"],
      "@ui/*": ["./src/components/ui/*"],
      "@schemas/*": ["./src/schemas/*"],
      "@providers/*": ["./src/providers/*"],
      "@img/*": ["./assets/images/*"],
      "@lib/*": ["./src/lib/*"],
      "@screens/*": ["./src/screens/*"],
      "@services/*": ["./src/services/*"],
      "@constants/*": ["./src/constants/*"],
      "@fonts/*": ["./assets/fonts/*"],
      "@contexts/*": ["./src/contexts/*"],
      "@data/*": ["./src/data/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts"
  ],
  "exclude": ["node_modules", "src/**/*.test.ts"]
}
