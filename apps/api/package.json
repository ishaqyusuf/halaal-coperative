{
  "name": "@halaalvest/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "--build": "tsc --noEmit",
    "dev": "bun --env-file=/dev/null ../../../local-infra-kit/bin/with-env.ts --profile halaalvest -- TZ=UTC PORTLESS_WILDCARD=1 portless api.halaalvest bun --watch src/index.ts",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "exports": {
    "./context": "./src/context.ts",
    "./internal-api": "./src/internal-api.ts",
    "./router": "./src/routers/_app.ts",
    "./trpc": "./src/lib.trpc.ts",
    "./trpc/init": "./src/lib.trpc.ts",
    "./trpc/transformer": "./src/transformer.ts",
    "./trpc/routers/_app": "./src/routers/_app.ts",
    "./trpc/routers/dashboard-actions": "./src/routers/dashboard-actions.route.ts",
    "./app-update": "./src/app-update/handler.ts",
    "./qa-accelerator-config": "./src/qa-accelerator-config.ts",
    "./cooperative-paystack-webhook": "./src/billing/cooperative-paystack-webhook.ts"
  },
  "dependencies": {
    "@ai-sdk/deepseek": "2.0.26",
    "@ai-sdk/openai": "3.0.48",
    "@halaalvest/assistant": "workspace:*",
    "@halaalvest/auth": "workspace:*",
    "@halaalvest/backfill": "workspace:*",
    "@halaalvest/db": "workspace:*",
    "@halaalvest/domain": "workspace:*",
    "@halaalvest/errors": "workspace:*",
    "@halaalvest/events": "workspace:*",
    "@halaalvest/jobs": "workspace:*",
    "@halaalvest/notifications": "workspace:*",
    "@halaalvest/observability": "workspace:*",
    "@halaalvest/utils": "workspace:*",
    "@hono/node-server": "^1.19.6",
    "@prisma/client-runtime-utils": "7.7.0",
    "@sentry/bun": "10.32.1",
    "@trpc/server": "^11.18.0",
    "ai": "6.0.141",
    "hono": "^4.13.8",
    "superjson": "^2.2.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^25.1.0",
    "@halaalvest/eslint-config": "workspace:*",
    "@halaalvest/tsconfig": "workspace:*",
    "eslint": "^9.39.2",
    "typescript": "^5.9.3"
