# ── BILLING CHECKOUT LINKS ─────────────────────────────────────────
# Billing integration: exact HTTPS checkout hosts; empty until provider approval.
HALAALVEST_BILLING_CHECKOUT_HOSTS=

# ── DATABASE ──────────────────────────────────────────────
# Preview-mode database configuration.
HALAALVEST_DATABASE_URL=
# ── RELEASE / SEPARATE TRIGGER PREVIEW PROJECT ─────────────────────
APP_ENV=preview
# Create HalaalVest Preview in Trigger; both projects use provider env prod.
# Never use Production proj_ajaddxidcuphhhckxwja here.
TRIGGER_PROJECT_ID=
TRIGGER_SECRET_KEY=
# Personal access token for CLI deploys. Kept local; never synced to workers.
TRIGGER_ACCESS_TOKEN=
# Set these public origins locally AND in Expo's preview environment.
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_DASHBOARD_URL=
EXPO_PUBLIC_LEGAL_ORIGIN=
# Mobile EAS preview URL values are configured separately and must target this
# isolated preview deployment. Never attach a QA-enabled preview client to the
# production API/database.

# ── API OBSERVABILITY ──────────────────────────────────────────────
# Observability remains disabled in preview; values are placeholders only.
SENTRY_DSN_API=
SENTRY_ENVIRONMENT_API=preview
SENTRY_RELEASE_API=
SENTRY_PROJECT_API=

# ── DASHBOARD OBSERVABILITY ──────────────────────────────────────────────
SENTRY_DSN_DASHBOARD=
NEXT_PUBLIC_SENTRY_DSN_DASHBOARD=
SENTRY_ENVIRONMENT_DASHBOARD=preview
NEXT_PUBLIC_SENTRY_ENVIRONMENT_DASHBOARD=preview
SENTRY_RELEASE_DASHBOARD=
NEXT_PUBLIC_SENTRY_RELEASE_DASHBOARD=
SENTRY_PROJECT_DASHBOARD=

# ── MARKETING OBSERVABILITY ──────────────────────────────────────────────
SENTRY_DSN_MARKETING=
NEXT_PUBLIC_SENTRY_DSN_MARKETING=
SENTRY_ENVIRONMENT_MARKETING=preview
NEXT_PUBLIC_SENTRY_ENVIRONMENT_MARKETING=preview
SENTRY_RELEASE_MARKETING=
NEXT_PUBLIC_SENTRY_RELEASE_MARKETING=
SENTRY_PROJECT_MARKETING=

# ── JOBS OBSERVABILITY ──────────────────────────────────────────────
SENTRY_DSN_JOBS=
SENTRY_ENVIRONMENT_JOBS=preview
SENTRY_RELEASE_JOBS=
SENTRY_PROJECT_JOBS=

# ── MOBILE OBSERVABILITY ──────────────────────────────────────────────
EXPO_PUBLIC_SENTRY_DSN_MOBILE=
EXPO_PUBLIC_SENTRY_ENABLED_MOBILE=false
EXPO_PUBLIC_SENTRY_ENVIRONMENT_MOBILE=preview
EXPO_PUBLIC_SENTRY_RELEASE_MOBILE=
EXPO_PUBLIC_SENTRY_SMOKE_TEST_MOBILE=false
SENTRY_PROJECT_MOBILE=

# ── SENTRY DEPLOYMENT ──────────────────────────────────────────────
SENTRY_DISABLE_AUTO_UPLOAD=true
SENTRY_ORG=
SENTRY_AUTH_TOKEN=
HALAALVEST_ENV=preview
QA_ACCELERATOR_ENABLED=true
QA_ACCELERATOR_SECRET=replace-with-a-preview-only-secret
QA_ACCELERATOR_TESTER_CREDENTIAL=replace-with-a-preview-tester-credential
QA_ACCELERATOR_CLIENT_KINDS=mobile,web
