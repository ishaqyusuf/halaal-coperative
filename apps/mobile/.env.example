# ── RUNTIME URLS AND ORIGINS ──────────────────────────────────────────────
EXPO_PUBLIC_API_URL=http://localhost:1442
EXPO_PUBLIC_DASHBOARD_URL=http://localhost:1441
# Set only after the target's approved public legal and support pages are live.
# Required for store-qa and production builds; omit for draft/native validation.
EXPO_PUBLIC_LEGAL_ORIGIN=

# ── MOBILE RUNTIME ──────────────────────────────────────────────
EXPO_PUBLIC_APP_VARIANT=development
# Use preview for the isolated preview app identity and QA client surface. A
# preview build must point the URLs above at isolated preview services, never at
# the production API or dashboard.
EXPO_PORT=3002

# ── EXPO DEPLOYMENT ──────────────────────────────────────────────
HALAALVEST_EXPO_PROJECT_ID=
HALAALVEST_EXPO_OWNER=

# ── MOBILE OBSERVABILITY ──────────────────────────────────────────────
EXPO_PUBLIC_SENTRY_DSN_MOBILE=
EXPO_PUBLIC_SENTRY_ENABLED_MOBILE=false
EXPO_PUBLIC_SENTRY_ENVIRONMENT_MOBILE=
EXPO_PUBLIC_SENTRY_RELEASE_MOBILE=
EXPO_PUBLIC_SENTRY_SMOKE_TEST_MOBILE=false
SENTRY_PROJECT_MOBILE=

# ── SENTRY DEPLOYMENT ──────────────────────────────────────────────
# Private EAS build secrets, used for source-map upload only.
SENTRY_ORG=
SENTRY_AUTH_TOKEN=
SENTRY_DISABLE_AUTO_UPLOAD=true
