{
  "name": "@halaalvest/mobile",
  "main": "expo-router/entry",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "bun run with-env node ./scripts/run-expo-cli.cjs run:android",
    "check:native-imports": "node ./scripts/check-native-imports.mjs",
    "check:smoke": "node ./scripts/check-smoke-coverage.mjs",
    "dev": "bun run with-env node ./scripts/run-expo-cli.cjs start --port ${EXPO_PORT:-3002}",
    "eas-build:dev": "BUN_AUTO_INSTALL=0 bun run with-env eas build --profile development --platform android",
    "eas-build:preview": "BUN_AUTO_INSTALL=0 bun run with-env:prod eas build -p android --profile preview",
    "eas-update:preview": "bun run update:preview",
    "ios": "bun run with-env node ./scripts/run-expo-cli.cjs run:ios",
    "lint": "eslint .",
    "start": "bun run dev",
    "typecheck": "tsc --noEmit",
    "update:preview": "node ./scripts/update-preview.mjs",
    "web": "bun run with-env node ./scripts/run-expo-cli.cjs start --web",
    "with-env": "node ../../scripts/with-workspace-env.mjs",
    "with-env:prod": "node ../../scripts/with-workspace-env.mjs APP_ENV=production"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@gorhom/bottom-sheet": "^5.0.5",
    "@halaalvest/api": "workspace:*",
    "@hookform/resolvers": "^5.2.2",
    "@legendapp/list": "^2.0.15",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "@rn-primitives/alert-dialog": "^1.2.0",
    "@rn-primitives/label": "^1.2.0",
    "@rn-primitives/slot": "^1.2.0",
    "@rn-primitives/switch": "^1.2.0",
    "@rn-primitives/tabs": "^1.2.0",
    "@tanstack/react-query": "^5.100.14",
    "@trpc/client": "^11.18.0",
    "@trpc/tanstack-react-query": "^11.18.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "expo": "~54.0.35",
    "expo-constants": "~18.0.10",
    "expo-dev-client": "~6.0.21",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-navigation-bar": "~5.0.10",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.11",
    "expo-status-bar": "~3.0.8",
    "expo-system-ui": "~6.0.8",
    "expo-updates": "~29.0.18",
    "expo-web-browser": "~15.0.11",
    "lucide-react-native": "^0.545.0",
    "nativewind": "5.0.0-preview.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.66.0",
    "react-native": "0.81.5",
    "react-native-css": "3.0.1",
    "react-native-css-interop": "0.2.1",
    "react-native-flash-message": "^0.4.2",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-keyboard-controller": "1.18.5",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-toast-message": "^2.3.3",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1",
    "superjson": "^2.2.2",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.1.11",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@halaalvest/eslint-config": "workspace:^",
    "@halaalvest/tsconfig": "workspace:*",
    "@tailwindcss/postcss": "4.1.18",
    "@tanstack/eslint-plugin-query": "^5.91.2",
    "@types/react": "~19.1.10",
    "babel-preset-expo": "~54.0.11",
    "eslint": "^9.39.2",
    "eslint-config-expo": "~10.0.0",
    "postcss": "^8.5.6",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "4.1.18",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@types/react": "~19.1.10",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5"
  }
