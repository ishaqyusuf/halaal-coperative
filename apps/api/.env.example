# ── BILLING CHECKOUT LINKS ─────────────────────────────────────────
# Exact provider checkout hostnames, comma separated. Empty disables checkout links.
# Does not configure or activate a billing provider.
HALAALVEST_BILLING_CHECKOUT_HOSTS=

# ── API OBSERVABILITY ──────────────────────────────────────────────
# API diagnostics are enabled only when NODE_ENV and this environment are production.
SENTRY_DSN_API=
SENTRY_ENVIRONMENT_API=
SENTRY_RELEASE_API=

# ── SENTRY DEPLOYMENT ──────────────────────────────────────────────
SENTRY_PROJECT_API=
SENTRY_ORG=
# Private build secret; never expose it to application clients.
SENTRY_AUTH_TOKEN=
HALAALVEST_ENV=local
QA_ACCELERATOR_ENABLED=true
QA_ACCELERATOR_SECRET=replace-with-a-non-production-secret
QA_ACCELERATOR_TESTER_CREDENTIAL=replace-with-a-local-tester-credential
QA_ACCELERATOR_CLIENT_KINDS=mobile,web
HALAALVEST_MOBILE_URL_SCHEME=halaalvest

# Legacy Google pending-refund review. No code reads these any more; keep the
# deployed keys until every pending refund row encrypted under them is resolved
# and purged.
STORE_REFUND_REVIEW_KEYS_JSON=
STORE_REFUND_REVIEW_ACTIVE_KEY_ID=
PAYSTACK_CHECKOUT_ENABLED=false
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SIGNING_SECRET=
PAYSTACK_SANDBOX_TENANT_ID=

# ── ASSISTANT MESSAGING CHANNELS ───────────────────────────────────
# Off by default. Each channel runs only when its flag is "true" and every
# value below it is set. Webhooks: /api/webhooks/assistant/telegram and
# /api/webhooks/assistant/whatsapp. Never commit real tokens or secrets.
ASSISTANT_TELEGRAM_ENABLED=false
ASSISTANT_TELEGRAM_BOT_TOKEN=
# Sent by Telegram as X-Telegram-Bot-Api-Secret-Token (setWebhook secret_token).
ASSISTANT_TELEGRAM_WEBHOOK_SECRET=
ASSISTANT_TELEGRAM_BOT_USERNAME=
ASSISTANT_WHATSAPP_ENABLED=false
# Meta app secret: verifies X-Hub-Signature-256 on webhook bodies.
ASSISTANT_WHATSAPP_APP_SECRET=
# Echoed back during the Cloud API GET verify handshake.
ASSISTANT_WHATSAPP_VERIFY_TOKEN=
ASSISTANT_WHATSAPP_ACCESS_TOKEN=
ASSISTANT_WHATSAPP_PHONE_NUMBER_ID=
# Optional: sender number in international format, for wa.me link buttons.
ASSISTANT_WHATSAPP_DISPLAY_NUMBER=
