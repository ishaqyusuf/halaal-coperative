# Release setup: copy the values into .env.production without committing secrets.
APP_ENV=production
HALAALVEST_DATABASE_URL=
TRIGGER_PROJECT_ID=proj_ajaddxidcuphhhckxwja
TRIGGER_SECRET_KEY=
# Local CLI personal access token; never synced to workers.
TRIGGER_ACCESS_TOKEN=

# Set these locally AND in Expo's production environment.
EXPO_PUBLIC_API_URL=https://app.halaalvest.com
EXPO_PUBLIC_DASHBOARD_URL=https://app.halaalvest.com
EXPO_PUBLIC_LEGAL_ORIGIN=https://halaalvest.com
HALAALVEST_EXPO_PROJECT_ID=3fb3e5e2-bd84-4308-8739-e9f4436d0da9
HALAALVEST_EXPO_OWNER=cipron-startups

# Job email transport: add reviewed values before enabling real delivery.
EMAIL_DELIVERY_MODE=
EMAIL_FROM_ADDRESS=
EMAIL_REPLY_TO=
RESEND_API_KEY=

# Optional Production observability. Never use Production DSNs in Preview.
SENTRY_DSN_JOBS=
SENTRY_ENVIRONMENT_JOBS=production
SENTRY_RELEASE_JOBS=
