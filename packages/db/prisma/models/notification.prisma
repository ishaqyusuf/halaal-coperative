model NotificationPreference {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  role             String?
  notificationType String   @map("notification_type")
  channel          String   @default("email")
  enabled          Boolean  @default(true)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, role, notificationType, channel], map: "notification_preferences_tenant_role_type_channel_key")
  @@index([tenantId, role], map: "notification_preferences_tenant_role_idx")
  @@map("notification_preferences")
}

model MobileUserNotificationPreference {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  notificationType String   @map("notification_type") @db.VarChar(80)
  channel          String   @default("push") @db.VarChar(24)
  enabled          Boolean  @default(true)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, notificationType, channel], map: "mobile_user_notification_preferences_scope_key")
  @@index([tenantId, userId, channel], map: "mobile_user_notification_preferences_scope_idx")
  @@map("mobile_user_notification_preferences")
}

model MobilePushRegistration {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId              String    @map("tenant_id") @db.Uuid
  userId                String    @map("user_id") @db.Uuid
  mobileDeviceSessionId String    @unique @map("mobile_device_session_id") @db.Uuid
  provider              String    @default("expo") @db.VarChar(24)
  providerToken         String    @map("provider_token")
  tokenHash             String    @unique @map("token_hash") @db.VarChar(64)
  platform              String    @db.VarChar(40)
  permissionStatus      String    @map("permission_status") @db.VarChar(40)
  projectId             String?   @map("project_id") @db.VarChar(120)
  status                String    @default("active") @db.VarChar(24)
  failureCode           String?   @map("failure_code") @db.VarChar(80)
  registeredAt          DateTime  @default(now()) @map("registered_at") @db.Timestamptz(6)
  lastValidatedAt       DateTime  @default(now()) @map("last_validated_at") @db.Timestamptz(6)
  disabledAt            DateTime? @map("disabled_at") @db.Timestamptz(6)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant              Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  mobileDeviceSession MobileDeviceSession @relation(fields: [mobileDeviceSessionId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, status], map: "mobile_push_registrations_recipient_state_idx")
  @@index([status, lastValidatedAt], map: "mobile_push_registrations_provider_state_idx")
  @@map("mobile_push_registrations")
}
