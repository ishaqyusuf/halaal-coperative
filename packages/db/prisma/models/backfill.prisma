model TenantShareStructureVersion {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  effectiveFrom DateTime @map("effective_from") @db.Date
  amount        Decimal  @db.Decimal(18, 2)
  notes         String?
  createdByUserId String? @map("created_by_user_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, effectiveFrom], map: "tenant_share_versions_tenant_effective_key")
  @@index([tenantId, effectiveFrom], map: "tenant_share_versions_tenant_effective_idx")
  @@map("tenant_share_structure_versions")
}

model MemberShareOverride {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  memberId      String   @map("member_id") @db.Uuid
  effectiveFrom DateTime @map("effective_from") @db.Date
  amount        Decimal  @db.Decimal(18, 2)
  notes         String?
  createdByUserId String? @map("created_by_user_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, effectiveFrom], map: "member_share_overrides_member_effective_key")
  @@index([tenantId, memberId, effectiveFrom], map: "member_share_overrides_tenant_member_effective_idx")
  @@map("member_share_overrides")
}

