{
  "name": "@halaalvest/jobs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./tasks": "./src/tasks/index.ts"
  },
  "scripts": {
    "deploy": "bun --env-file=/dev/null ../../../local-infra-kit/bin/with-env.ts --profile halaalvest --mode prod -- sh -c 'node --max-old-space-size=4096 ../../packages/db/node_modules/.bin/prisma generate --config ../../packages/db/prisma.config.ts && node ../../scripts/with-trigger-profile.mjs -- trigger deploy --skip-update-check'",
    "dev": "bun --env-file=/dev/null ../../../local-infra-kit/bin/with-env.ts --profile halaalvest -- node ../../scripts/with-trigger-profile.mjs -- trigger dev",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "with-env": "bun --env-file=/dev/null ../../../local-infra-kit/bin/with-env.ts --profile halaalvest --",
    "with-env:prod": "bun --env-file=/dev/null ../../../local-infra-kit/bin/with-env.ts --profile halaalvest --mode prod --"
  },
  "dependencies": {
    "@halaalvest/backfill": "workspace:*",
    "@halaalvest/db": "workspace:*",
    "@halaalvest/errors": "workspace:*",
    "@halaalvest/observability": "workspace:*",
    "@halaalvest/notifications": "workspace:*",
    "@sentry/node": "10.32.1",
    "@trigger.dev/build": "4.0.1",
    "@trigger.dev/sdk": "4.0.1",
    "trigger.dev": "4.0.1"
  },
  "devDependencies": {
    "@types/node": "^25.1.0",
    "@halaalvest/eslint-config": "workspace:*",
    "@halaalvest/tsconfig": "workspace:*",
    "@sentry/esbuild-plugin": "4.6.1",
    "eslint": "^9.39.2",
    "typescript": "^5.9.3"
  }
}
