  @@index([tenantId, memberId, month], map: "migration_backfill_adjustments_tenant_member_month_idx")
  @@map("migration_backfill_adjustments")
}

model MemberOpeningBalance {
  id                                  String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId                            String                     @map("tenant_id") @db.Uuid
  memberId                            String                     @map("member_id") @db.Uuid
  openingDate                         DateTime                   @map("opening_date") @db.Date
  status                              MemberOpeningBalanceStatus @default(pending_review)
  commitmentSavingsBalance            Decimal                    @default(0) @map("commitment_savings_balance") @db.Decimal(18, 2)
  specialSavingsBalance               Decimal                    @default(0) @map("special_savings_balance") @db.Decimal(18, 2)
  shareCapitalBalance                 Decimal                    @default(0) @map("share_capital_balance") @db.Decimal(18, 2)
  shareUnits                          Int?                       @map("share_units")
  activeFinancingOutstanding          Decimal                    @default(0) @map("active_financing_outstanding") @db.Decimal(18, 2)
  activeFinancingOriginalAmount       Decimal                    @default(0) @map("active_financing_original_amount") @db.Decimal(18, 2)
  activeFinancingOpenedAt             DateTime?                  @map("active_financing_opened_at") @db.Date
  activeFinancingRepaymentMonths      Int?                       @map("active_financing_repayment_months")
  activeFinancingInstallmentAmount    Decimal                    @default(0) @map("active_financing_installment_amount") @db.Decimal(18, 2)
  activeFinancingInstallmentsPaid     Int?                       @map("active_financing_installments_paid")
  activeFinancingGuarantorOneMemberId String?                    @map("active_financing_guarantor_one_member_id") @db.Uuid
  activeFinancingGuarantorTwoMemberId String?                    @map("active_financing_guarantor_two_member_id") @db.Uuid
  procurementOutstanding              Decimal                    @default(0) @map("procurement_outstanding") @db.Decimal(18, 2)
  procurementItemName                 String?                    @map("procurement_item_name")
  procurementOpenedAt                 DateTime?                  @map("procurement_opened_at") @db.Date
  procurementOriginalAmount           Decimal                    @default(0) @map("procurement_original_amount") @db.Decimal(18, 2)
  procurementRepaymentMonths          Int?                       @map("procurement_repayment_months")
  procurementInstallmentAmount        Decimal                    @default(0) @map("procurement_installment_amount") @db.Decimal(18, 2)
  procurementInstallmentsPaid         Int?                       @map("procurement_installments_paid")
  foodPurchaseOutstanding             Decimal                    @default(0) @map("food_purchase_outstanding") @db.Decimal(18, 2)
  foodPurchaseItemName                String?                    @map("food_purchase_item_name")
  foodPurchaseOpenedAt                DateTime?                  @map("food_purchase_opened_at") @db.Date
  foodPurchaseOriginalAmount          Decimal                    @default(0) @map("food_purchase_original_amount") @db.Decimal(18, 2)
  foodPurchaseRepaymentMonths         Int?                       @map("food_purchase_repayment_months")
  foodPurchaseInstallmentAmount       Decimal                    @default(0) @map("food_purchase_installment_amount") @db.Decimal(18, 2)
  foodPurchaseInstallmentsPaid        Int?                       @map("food_purchase_installments_paid")
  appliedLoanId                       String?                    @unique(map: "member_opening_balances_applied_loan_key") @map("applied_loan_id") @db.Uuid
  appliedProcurementRequestId         String?                    @unique(map: "member_opening_balances_applied_procurement_request_key") @map("applied_procurement_request_id") @db.Uuid
  appliedFoodPurchaseApplicationId    String?                    @unique(map: "member_opening_balances_applied_food_purchase_application_key") @map("applied_food_purchase_application_id") @db.Uuid
  sourceDocumentUrl                   String?                    @map("source_document_url")
  sourceDocumentName                  String?                    @map("source_document_name")
  notes                               String?
  reviewNotes                         String?                    @map("review_notes")
  createdByUserId                     String?                    @map("created_by_user_id") @db.Uuid
  reviewedByUserId                    String?                    @map("reviewed_by_user_id") @db.Uuid
  reviewedAt                          DateTime?                  @map("reviewed_at") @db.Timestamptz(6)
  appliedByUserId                     String?                    @map("applied_by_user_id") @db.Uuid
  appliedAt                           DateTime?                  @map("applied_at") @db.Timestamptz(6)
  reversedByUserId                    String?                    @map("reversed_by_user_id") @db.Uuid
  reversedAt                          DateTime?                  @map("reversed_at") @db.Timestamptz(6)
  reversalNotes                       String?                    @map("reversal_notes")
  createdAt                           DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                           DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant                         Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  member                         Member                   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  appliedLoan                    Loan?                    @relation("MemberOpeningBalanceAppliedLoan", fields: [appliedLoanId], references: [id], onDelete: SetNull)
  appliedProcurementRequest      ProcurementRequest?      @relation("MemberOpeningBalanceAppliedProcurement", fields: [appliedProcurementRequestId], references: [id], onDelete: SetNull)
  appliedFoodPurchaseApplication FoodPurchaseApplication? @relation("MemberOpeningBalanceAppliedFoodPurchase", fields: [appliedFoodPurchaseApplicationId], references: [id], onDelete: SetNull)

  @@unique([tenantId, memberId, openingDate], map: "member_opening_balances_member_date_key")
  @@index([tenantId, status], map: "member_opening_balances_tenant_status_idx")
  @@index([tenantId, memberId, status], map: "member_opening_balances_tenant_member_status_idx")
  @@map("member_opening_balances")
}

model TenantBroughtForwardSnapshot {
  id                        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId                  String   @unique @map("tenant_id") @db.Uuid
  asOfDate                  DateTime @map("as_of_date") @db.Date
  memberCountSnapshot       Int      @map("member_count_snapshot")
  totalMemberSavingsAmount  Decimal  @map("total_member_savings_amount") @db.Decimal(18, 2)
  totalSpecialSavingsAmount Decimal  @default(0) @map("total_special_savings_amount") @db.Decimal(18, 2)
  totalShareUnits           Int      @map("total_share_units")
  shareUnitAmountSnapshot   Decimal  @map("share_unit_amount_snapshot") @db.Decimal(18, 2)
  totalShareCapitalAmount   Decimal  @map("total_share_capital_amount") @db.Decimal(18, 2)
  notes                     String?
  createdAt                 DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_brought_forward_snapshots")
}

model BackfillBatch {
  id              String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String              @map("tenant_id") @db.Uuid
  memberId        String              @map("member_id") @db.Uuid
  rangeStart      DateTime            @map("range_start") @db.Date
  rangeEnd        DateTime            @map("range_end") @db.Date
  status          BackfillBatchStatus @default(draft)
  draftInput      Json?               @map("draft_input")
  warnings        Json?
  summary         Json?
  generatedAt     DateTime?           @map("generated_at") @db.Timestamptz(6)
  approvedAt      DateTime?           @map("approved_at") @db.Timestamptz(6)
  appliedAt       DateTime?           @map("applied_at") @db.Timestamptz(6)
  createdByUserId String?             @map("created_by_user_id") @db.Uuid
  updatedByUserId String?             @map("updated_by_user_id") @db.Uuid
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant        Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  member        Member                 @relation(fields: [memberId], references: [id], onDelete: Cascade)
  monthRows     BackfillMonthRow[]
  activities    BackfillActivity[]
  appliedMonths AppliedBackfillMonth[]

  @@index([tenantId, memberId, status], map: "backfill_batches_tenant_member_status_idx")
  @@index([tenantId, createdAt], map: "backfill_batches_tenant_created_at_idx")
  @@map("backfill_batches")
}

model AppliedBackfillMonth {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  memberId        String   @map("member_id") @db.Uuid
  batchId         String   @map("batch_id") @db.Uuid
  month           DateTime @db.Date
  sourceKey       String   @map("source_key")
  appliedByUserId String?  @map("applied_by_user_id") @db.Uuid
  appliedAt       DateTime @default(now()) @map("applied_at") @db.Timestamptz(6)

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  member Member        @relation(fields: [memberId], references: [id], onDelete: Cascade)
  batch  BackfillBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@unique([tenantId, memberId, month], map: "applied_backfill_months_member_month_key")
  @@unique([tenantId, sourceKey], map: "applied_backfill_months_source_key_key")
  @@index([tenantId, batchId], map: "applied_backfill_months_tenant_batch_idx")
  @@index([tenantId, memberId, month], map: "applied_backfill_months_tenant_member_month_idx")
  @@map("applied_backfill_months")
}

model BackfillMonthRow {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String   @map("tenant_id") @db.Uuid
  batchId            String   @map("batch_id") @db.Uuid
  year               Int
  month              Int
  rowStatus          String   @default("active") @map("row_status")
  amount             Decimal  @db.Decimal(18, 2)
  charge             Decimal  @default(0) @db.Decimal(18, 2)
  loanCollected      Decimal  @default(0) @map("loan_collected") @db.Decimal(18, 2)
  loanServiceAmount  Decimal  @default(0) @map("loan_service_amount") @db.Decimal(18, 2)
  monthlyTopup       Decimal  @default(0) @map("monthly_topup") @db.Decimal(18, 2)
  pendingLoanPayment Decimal  @default(0) @map("pending_loan_payment") @db.Decimal(18, 2)
  share              Decimal  @default(0) @db.Decimal(18, 2)
  dividend           Decimal  @default(0) @db.Decimal(18, 2)
  totalShare         Decimal  @default(0) @map("total_share") @db.Decimal(18, 2)
  total              Decimal  @default(0) @db.Decimal(18, 2)
  chargeBreakdown    Json?    @map("charge_breakdown")
  metadata           Json?
  isGenerated        Boolean  @default(true) @map("is_generated")
  isEdited           Boolean  @default(false) @map("is_edited")
  notes              String?
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant     Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  batch      BackfillBatch      @relation(fields: [batchId], references: [id], onDelete: Cascade)
  activities BackfillActivity[]

  @@unique([batchId, year, month], map: "backfill_month_rows_batch_year_month_key")
  @@index([tenantId, batchId], map: "backfill_month_rows_tenant_batch_idx")
  @@map("backfill_month_rows")
}

model BackfillActivity {
  id              String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String               @map("tenant_id") @db.Uuid
  batchId         String               @map("batch_id") @db.Uuid
  monthRowId      String               @map("month_row_id") @db.Uuid
  activityType    BackfillActivityType @map("activity_type")
  activityDate    DateTime             @map("activity_date") @db.Date
  amount          Decimal              @db.Decimal(18, 2)
  direction       String               @default("credit")
  notes           String?
  metadata        Json?
  createdByUserId String?              @map("created_by_user_id") @db.Uuid
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  batch    BackfillBatch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  monthRow BackfillMonthRow @relation(fields: [monthRowId], references: [id], onDelete: Cascade)

  @@index([tenantId, batchId], map: "backfill_activities_tenant_batch_idx")
  @@index([monthRowId, activityDate], map: "backfill_activities_month_row_date_idx")
  @@map("backfill_activities")
}
