    "@tanstack/eslint-plugin-query": "^5.91.2",
    "@types/react": "~19.1.10",
    "babel-preset-expo": "~54.0.11",
    "eslint": "^9.39.2",
    "eslint-config-expo": "~10.0.0",
    "postcss": "^8.5.6",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "4.1.18",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@types/react": "~19.1.10",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5"
  }
