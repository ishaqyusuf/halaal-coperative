# ── APPLICATION AND FEATURE CONFIGURATION ──────────────────────────────────────────────
MARKETING_STAGE=prelaunch
MARKETING_EXPERIENCE=organic-trust-v1
MARKETING_EARLY_ACCESS_ENABLED=true
# Required to open /preview/marketing/<experience>?token=... in production.
MARKETING_EXPERIENCE_PREVIEW_TOKEN=replace-me-in-production
SHOW_HOME_PAGE=true

# ── RUNTIME URLS AND ORIGINS ──────────────────────────────────────────────
PLATFORM_ROOT_DOMAIN=halaalvest.com
LOCAL_ROOT_DOMAIN=halaalvest.localhost
TENANT_ROOT_DOMAIN=halaalvest.localhost
DASHBOARD_ROOT_DOMAIN=halaalvest-dash.localhost
WEB_APP_ROOT_DOMAIN=halaalvest.localhost
WEB_PORTLESS_ROOT_DOMAIN=halaalvest.localhost
LOCAL_HOSTNAME=localhost
DASHBOARD_APP_URL=https://halaalvest-dash.localhost
TENANT_SITE_APP_URL=https://halaalvest.localhost

# ── DEVELOPMENT PORTS ──────────────────────────────────────────────
MARKETING_PORT=1440
DASHBOARD_PORT=1441

# ── AUTHENTICATION AND SIGNING ──────────────────────────────────────────────
SIGNUP_TOKEN_SECRET=replace-me-in-production
# Shared by marketing request and verification handlers; 32+ random characters in production.
PRIVACY_REQUEST_CHALLENGE_SECRET=replace-with-a-long-random-secret
EARLY_ACCESS_TOKEN_SECRET=replace-me-in-production

# ── EMAIL AND CUSTOMER MESSAGING ──────────────────────────────────────────────
MARKETING_ADMIN_EMAILS=admin@your-domain.com
EMAIL_DELIVERY_MODE=console
# Explicit QA routing is supported in any environment:
# EMAIL_DELIVERY_MODE=qa_routed
# EMAIL_QA_DOMAIN_ROUTES='{"ishaq.qa.test":"ishaq@example.com","mubarak.qa.test":"mubarak@example.com"}'
EMAIL_FROM_ADDRESS="Welcome to Halaalvest <notifications@your-domain.com>"
EMAIL_REPLY_TO="support@your-domain.com"
RESEND_API_KEY=re_replace_in_production

# ── MARKETING OBSERVABILITY ──────────────────────────────────────────────
# Configure these independently in the marketing deployment.
SENTRY_DSN_MARKETING=
NEXT_PUBLIC_SENTRY_DSN_MARKETING=
SENTRY_ENVIRONMENT_MARKETING=
NEXT_PUBLIC_SENTRY_ENVIRONMENT_MARKETING=
SENTRY_RELEASE_MARKETING=
NEXT_PUBLIC_SENTRY_RELEASE_MARKETING=
SENTRY_PROJECT_MARKETING=

# ── SENTRY DEPLOYMENT ──────────────────────────────────────────────
SENTRY_ORG=
# Private build secret; never expose with a NEXT_PUBLIC_ prefix.
SENTRY_AUTH_TOKEN=
