model Member {
  id                          String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId                    String                      @map("tenant_id") @db.Uuid
  userId                      String?                     @unique @map("user_id") @db.Uuid
  memberNumber                String                      @map("member_number")
  fullName                    String                      @map("full_name")
  memberType                  MemberType                  @map("member_type")
  status                      MemberStatus                @default(active)
  joinedAt                    DateTime                    @map("joined_at") @db.Timestamptz(6)
  exitedAt                    DateTime?                   @map("exited_at") @db.Timestamptz(6)
  email                       String?
  phoneNumber                 String?                     @map("phone_number")
  address                     String?
  occupation                  String?
  totalSavingsSnapshot        Decimal                     @default(0) @map("total_savings_snapshot") @db.Decimal(18, 2)
  paymentAllocationPreference PaymentAllocationPreference @default(manual_split) @map("payment_allocation_preference")
  kycStatus                   KycStatus                   @default(not_started) @map("kyc_status")
  governmentIdNumber          String?                     @map("government_id_number")
  kycDocumentType             String?                     @map("kyc_document_type")
  kycDocumentUrl              String?                     @map("kyc_document_url")
  kycDocumentUploadedAt       DateTime?                   @map("kyc_document_uploaded_at") @db.Timestamptz(6)
  kycReviewNotes              String?                     @map("kyc_review_notes")
  deductionSourceId           String?                     @map("deduction_source_id") @db.Uuid
  createdAt                   DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                   DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant                               Tenant                        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                                 User?                         @relation(fields: [userId], references: [id], onDelete: SetNull)
  deductionSource                      DeductionSource?              @relation(fields: [deductionSourceId], references: [id], onDelete: SetNull)
  contributionPlans                    ContributionPlan[]
  contributions                        Contribution[]
  shareOverrides                       MemberShareOverride[]
  amountLogs                           MemberAmountLog[]
  chargeApplications                   ChargeApplication[]
  loanRequests                         LoanRequest[]
  loans                                Loan[]
  backfillBatches                      BackfillBatch[]
  appliedBackfillMonths                AppliedBackfillMonth[]
  repayments                           Repayment[]
  collectionFollowUps                  CollectionFollowUp[]
  documents                            MemberDocument[]
  monthlyRecordMembers                 MonthlyRecordMember[]
  dividendAllocations                  DividendAllocation[]
  shareLedgerEntries                   MemberShareLedgerEntry[]
  shareProfitAllocations               ShareProfitAllocation[]
  ledgerTransactions                   LedgerTransaction[]
  offlineSyncEvents                    OfflineSyncEvent[]
  legacyLoanMigrationDrafts            LegacyLoanMigrationDraft[]    @relation("LegacyLoanMigrationDraftMember")
  legacyLoanMigrationDraftGuarantorOne LegacyLoanMigrationDraft[]    @relation("LegacyLoanMigrationDraftGuarantorOne")
  legacyLoanMigrationDraftGuarantorTwo LegacyLoanMigrationDraft[]    @relation("LegacyLoanMigrationDraftGuarantorTwo")
  migrationBackfillAdjustments         MigrationBackfillAdjustment[]
  activityEvents                       MemberActivityEvent[]
  migrationProfitAdjustments           MigrationProfitAdjustment[]

  @@unique([tenantId, memberNumber], map: "members_tenant_member_number_key")
  @@index([tenantId, status], map: "members_tenant_status_idx")
  @@index([tenantId, memberType], map: "members_tenant_member_type_idx")
  @@map("members")
}

model MemberActivityEvent {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  memberId        String   @map("member_id") @db.Uuid
  effectiveMonth  DateTime @map("effective_month") @db.Date
  status          String   @db.VarChar(32)
  reason          String?  @db.VarChar(120)
  notes           String?
  createdByUserId String?  @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([tenantId, memberId, effectiveMonth], map: "member_activity_events_member_month_key")
  @@index([tenantId, memberId, effectiveMonth], map: "member_activity_events_tenant_member_month_idx")
  @@index([tenantId, status], map: "member_activity_events_tenant_status_idx")
  @@map("member_activity_events")
}

model MemberDocument {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  memberId     String    @map("member_id") @db.Uuid
  documentType String    @map("document_type")
  documentUrl  String    @map("document_url")
  reviewStatus String    @default("pending") @map("review_status")
  reviewNotes  String?   @map("review_notes")
  uploadedAt   DateTime  @default(now()) @map("uploaded_at") @db.Timestamptz(6)
  reviewedAt   DateTime? @map("reviewed_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([tenantId, memberId, reviewStatus], map: "member_documents_tenant_member_review_status_idx")
  @@index([tenantId, uploadedAt], map: "member_documents_tenant_uploaded_at_idx")
  @@map("member_documents")
}

model DeductionSource {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String              @map("tenant_id") @db.Uuid
  name              String
  type              DeductionSourceType
  externalReference String?             @map("external_reference")
  isActive          Boolean             @default(true) @map("is_active")
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  members Member[]

  @@unique([tenantId, name], map: "deduction_sources_tenant_name_key")
  @@index([tenantId, type], map: "deduction_sources_tenant_type_idx")
  @@map("deduction_sources")
}
