{
  "name": "@amanah/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "dev": "node ../../scripts/with-workspace-env.mjs bun --watch src/index.ts",
    "dev:portless": "node ../../scripts/with-workspace-env.mjs portless api.coopsaas bun --watch src/index.ts",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@amanah/auth": "workspace:*",
    "@amanah/db": "workspace:*",
    "@amanah/domain": "workspace:*",
    "@amanah/notifications": "workspace:*",
    "@amanah/utils": "workspace:*",
    "@hono/node-server": "^1.19.6",
    "@trpc/server": "^11.7.1",
    "hono": "^4.9.8",
    "superjson": "^2.2.2",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/node": "^25.1.0",
    "@amanah/eslint-config": "workspace:*",
    "@amanah/tsconfig": "workspace:*",
    "eslint": "^9.39.2",
    "typescript": "^5.9.3"
  }
}
