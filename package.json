{
  "name": "halaal-coperative",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev --parallel",
    "dev:api": "turbo dev --filter=@amanah/api",
    "dev:api:portless": "turbo dev:portless --filter=@amanah/api",
    "dev:web": "turbo dev --filter=@amanah/web",
    "dev:web:portless": "turbo dev:portless --filter=@amanah/web",
    "dev:dashboard": "turbo dev --filter=@amanah/dashboard",
    "dev:dashboard:portless": "turbo dev:portless --filter=@amanah/dashboard",
    "dev:tenant-site": "turbo dev --filter=@amanah/tenant-site",
    "dev:tenant-site:portless": "turbo dev:portless --filter=@amanah/tenant-site",
    "dev:portless": "turbo dev:portless --parallel",
    "lint": "turbo lint",
    "format": "turbo format",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "@amanah/eslint-config": "workspace:*",
    "@amanah/tsconfig": "workspace:*",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "turbo": "^2.8.17",
    "typescript": "5.9.3"
  },
  "packageManager": "bun@1.3.0",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
