{
  "name": "halaalvest",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "db:generate": "node ./scripts/with-workspace-env.mjs bun run --cwd packages/db db:generate",
    "db:migrate": "node ./scripts/with-workspace-env.mjs bun run --cwd packages/db db:migrate",
    "db:migrate:deploy": "node ./scripts/with-workspace-env.mjs bun run --cwd packages/db db:migrate:deploy",
    "db:push": "node ./scripts/with-workspace-env.mjs bun run --cwd packages/db db:push",
    "db:studio": "node ./scripts/with-workspace-env.mjs bun run --cwd packages/db db:studio",
    "kill:ports": "node ./scripts/with-workspace-env.mjs sh ./scripts/kill-port.sh",
    "dev:prepare": "bun run kill:ports && bun run db:migrate:deploy",
    "dev:prepare:websites": "bun run kill:ports",
    "dev": "bun run dev:prepare && turbo dev --parallel",
    "dev:api": "bun run dev:prepare && turbo dev --filter=@halaalvest/api",
    "dev:api:portless": "bun run dev:prepare && turbo dev:portless --filter=@halaalvest/api",
    "dev:websites": "bun run dev:prepare:websites && turbo dev --filter=@halaalvest/web --filter=@halaalvest/dashboard --filter=@halaalvest/jobs",
    "dev:web": "bun run dev:prepare && turbo dev --filter=@halaalvest/web",
    "dev:web:portless": "bun run dev:prepare && turbo dev:portless --filter=@halaalvest/web",
    "dev:dashboard": "bun run dev:prepare && turbo dev --filter=@halaalvest/dashboard",
    "dev:dashboard:portless": "bun run dev:prepare && turbo dev:portless --filter=@halaalvest/dashboard",
    "dev:mobile": "bun run dev:prepare && turbo dev --filter=@halaalvest/api --filter=@halaalvest/mobile",
    "dev:mobile:portless": "bun run dev:prepare && turbo dev:portless --filter=@halaalvest/api --filter=@halaalvest/mobile",
    "dev:portless": "bun run dev:prepare && turbo dev:portless --parallel",
    "dev:prod": "HALAALVEST_ENV=production HALAALVEST_REQUIRE_PROD_DATABASE_URL=1 turbo dev --parallel",
    "jobs:deploy": "bun run --filter @halaalvest/jobs deploy",
    "lint": "turbo lint",
    "lint:mobile": "turbo lint --filter=@halaalvest/mobile",
    "format": "turbo format",
    "terminal": "bash ./scripts/open-bun-script-terminal.sh",
    "typecheck": "turbo typecheck",
    "typecheck:mobile": "turbo typecheck --filter=@halaalvest/mobile",
    "test": "turbo test"
  },
  "devDependencies": {
    "@halaalvest/eslint-config": "workspace:*",
    "@halaalvest/tsconfig": "workspace:*",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "turbo": "^2.8.17",
    "typescript": "5.9.3"
  },
  "packageManager": "bun@1.3.0",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
