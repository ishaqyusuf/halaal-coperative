# ── DASHBOARD OBSERVABILITY ──────────────────────────────────────────────
# Configure this runtime independently from marketing and the API.
SENTRY_DSN_DASHBOARD=
NEXT_PUBLIC_SENTRY_DSN_DASHBOARD=
SENTRY_ENVIRONMENT_DASHBOARD=
NEXT_PUBLIC_SENTRY_ENVIRONMENT_DASHBOARD=
SENTRY_RELEASE_DASHBOARD=
NEXT_PUBLIC_SENTRY_RELEASE_DASHBOARD=
SENTRY_PROJECT_DASHBOARD=

# Set only after Terms, Privacy, Deletion and Support routes on this exact
# marketing origin pass target-specific HTTPS checks. Unset hides broken links.
DASHBOARD_PUBLIC_LEGAL_ORIGIN=

# Private evidence uploads: separate Preview/Production private fra1 stores.
# Keep disabled until retention, record access, deletion and live QA gates pass.
DASHBOARD_PRIVATE_BLOB_ENABLED=0
BLOB_READ_WRITE_TOKEN=
DASHBOARD_UPLOAD_SIGNING_SECRET=
DASHBOARD_UPLOAD_ORPHAN_CLEANUP_ENABLED=0
DASHBOARD_UPLOAD_CLEANUP_SECRET=

# ── SENTRY DEPLOYMENT ──────────────────────────────────────────────
SENTRY_ORG=
# Private build secret; never expose it with a NEXT_PUBLIC_ prefix.
SENTRY_AUTH_TOKEN=
