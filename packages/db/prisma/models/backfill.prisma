model ChargeDefinitionVersion {
  id                 String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String          @map("tenant_id") @db.Uuid
  chargeDefinitionId String          @map("charge_definition_id") @db.Uuid
  effectiveFrom      DateTime        @map("effective_from") @db.Date
  amount             Decimal         @db.Decimal(18, 2)
  kind               ChargeKind
  chargeValueType    ChargeValueType @default(fixed_amount) @map("charge_value_type")
  notes              String?
  createdByUserId    String?         @map("created_by_user_id") @db.Uuid
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  chargeDefinition ChargeDefinition @relation(fields: [chargeDefinitionId], references: [id], onDelete: Cascade)

  @@unique([chargeDefinitionId, effectiveFrom], map: "charge_definition_versions_definition_effective_key")
  @@index([tenantId, chargeDefinitionId, effectiveFrom], map: "charge_definition_versions_tenant_definition_effective_idx")
  @@map("charge_definition_versions")
}

model LegacyLoanMigrationDraft {
  id                                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId                           String    @map("tenant_id") @db.Uuid
  memberId                           String    @map("member_id") @db.Uuid
  loanLabel                          String    @map("loan_label")
  openedAt                           DateTime  @map("opened_at") @db.Date
  closedAt                           DateTime? @map("closed_at") @db.Date
  principalAmount                    Decimal   @map("principal_amount") @db.Decimal(18, 2)
  scheduledMonthlyPrincipalRepayment Decimal   @map("scheduled_monthly_principal_repayment") @db.Decimal(18, 2)
  savingsDuringLoan                  Decimal   @map("savings_during_loan") @db.Decimal(18, 2)
  outstandingPrincipalBalance        Decimal   @map("outstanding_principal_balance") @db.Decimal(18, 2)
  guarantorOneMemberId               String?   @map("guarantor_one_member_id") @db.Uuid
  guarantorTwoMemberId               String?   @map("guarantor_two_member_id") @db.Uuid
  notes                              String?
  createdByUserId                    String?   @map("created_by_user_id") @db.Uuid
  createdAt                          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant             Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  member             Member  @relation("LegacyLoanMigrationDraftMember", fields: [memberId], references: [id], onDelete: Cascade)
  guarantorOneMember Member? @relation("LegacyLoanMigrationDraftGuarantorOne", fields: [guarantorOneMemberId], references: [id], onDelete: SetNull, map: "legacy_loan_migration_drafts_g1_member_fkey")
  guarantorTwoMember Member? @relation("LegacyLoanMigrationDraftGuarantorTwo", fields: [guarantorTwoMemberId], references: [id], onDelete: SetNull, map: "legacy_loan_migration_drafts_g2_member_fkey")

  @@unique([tenantId, memberId, loanLabel, openedAt], map: "legacy_loan_migration_drafts_member_label_opened_key")
  @@index([tenantId, memberId, openedAt], map: "legacy_loan_migration_drafts_tenant_member_opened_idx")
  @@index([tenantId, guarantorOneMemberId], map: "legacy_loan_migration_drafts_tenant_g1_idx")
  @@index([tenantId, guarantorTwoMemberId], map: "legacy_loan_migration_drafts_tenant_g2_idx")
  @@index([tenantId, openedAt], map: "legacy_loan_migration_drafts_tenant_opened_idx")
  @@map("legacy_loan_migration_drafts")
}

model MigrationBackfillAdjustment {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId            String   @map("tenant_id") @db.Uuid
  memberId            String   @map("member_id") @db.Uuid
  month               DateTime @db.Date
  savingsContribution Decimal? @map("savings_contribution") @db.Decimal(18, 2)
  loanRepaymentAmount Decimal? @map("loan_repayment_amount") @db.Decimal(18, 2)
  loanRepaymentOnTime Boolean? @map("loan_repayment_on_time")
  rowStatus           String?  @map("row_status") @db.VarChar(32)
  notes               String?
  createdByUserId     String?  @map("created_by_user_id") @db.Uuid
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([tenantId, memberId, month], map: "migration_backfill_adjustments_member_month_key")
  @@index([tenantId, memberId, month], map: "migration_backfill_adjustments_tenant_member_month_idx")
  @@map("migration_backfill_adjustments")
}

model BackfillBatch {
  id              String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String              @map("tenant_id") @db.Uuid
  memberId        String              @map("member_id") @db.Uuid
  rangeStart      DateTime            @map("range_start") @db.Date
  rangeEnd        DateTime            @map("range_end") @db.Date
  status          BackfillBatchStatus @default(draft)
  draftInput      Json?               @map("draft_input")
  warnings        Json?
  summary         Json?
  generatedAt     DateTime?           @map("generated_at") @db.Timestamptz(6)
  approvedAt      DateTime?           @map("approved_at") @db.Timestamptz(6)
  appliedAt       DateTime?           @map("applied_at") @db.Timestamptz(6)
  createdByUserId String?             @map("created_by_user_id") @db.Uuid
  updatedByUserId String?             @map("updated_by_user_id") @db.Uuid
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant        Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  member        Member                 @relation(fields: [memberId], references: [id], onDelete: Cascade)
  monthRows     BackfillMonthRow[]
  activities    BackfillActivity[]
  appliedMonths AppliedBackfillMonth[]

  @@index([tenantId, memberId, status], map: "backfill_batches_tenant_member_status_idx")
  @@index([tenantId, createdAt], map: "backfill_batches_tenant_created_at_idx")
  @@map("backfill_batches")
}

model AppliedBackfillMonth {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  memberId        String   @map("member_id") @db.Uuid
  batchId         String   @map("batch_id") @db.Uuid
  month           DateTime @db.Date
  sourceKey       String   @map("source_key")
  appliedByUserId String?  @map("applied_by_user_id") @db.Uuid
  appliedAt       DateTime @default(now()) @map("applied_at") @db.Timestamptz(6)

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  member Member        @relation(fields: [memberId], references: [id], onDelete: Cascade)
  batch  BackfillBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@unique([tenantId, memberId, month], map: "applied_backfill_months_member_month_key")
  @@unique([tenantId, sourceKey], map: "applied_backfill_months_source_key_key")
  @@index([tenantId, batchId], map: "applied_backfill_months_tenant_batch_idx")
  @@index([tenantId, memberId, month], map: "applied_backfill_months_tenant_member_month_idx")
  @@map("applied_backfill_months")
}

model BackfillMonthRow {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String   @map("tenant_id") @db.Uuid
  batchId            String   @map("batch_id") @db.Uuid
  year               Int
  month              Int
  rowStatus          String   @default("active") @map("row_status")
  amount             Decimal  @db.Decimal(18, 2)
  charge             Decimal  @default(0) @db.Decimal(18, 2)
  loanCollected      Decimal  @default(0) @map("loan_collected") @db.Decimal(18, 2)
  loanServiceAmount  Decimal  @default(0) @map("loan_service_amount") @db.Decimal(18, 2)
  monthlyTopup       Decimal  @default(0) @map("monthly_topup") @db.Decimal(18, 2)
  pendingLoanPayment Decimal  @default(0) @map("pending_loan_payment") @db.Decimal(18, 2)
  share              Decimal  @default(0) @db.Decimal(18, 2)
  dividend           Decimal  @default(0) @db.Decimal(18, 2)
  totalShare         Decimal  @default(0) @map("total_share") @db.Decimal(18, 2)
  total              Decimal  @default(0) @db.Decimal(18, 2)
  chargeBreakdown    Json?    @map("charge_breakdown")
  metadata           Json?
  isGenerated        Boolean  @default(true) @map("is_generated")
  isEdited           Boolean  @default(false) @map("is_edited")
  notes              String?
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant     Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  batch      BackfillBatch      @relation(fields: [batchId], references: [id], onDelete: Cascade)
  activities BackfillActivity[]

  @@unique([batchId, year, month], map: "backfill_month_rows_batch_year_month_key")
  @@index([tenantId, batchId], map: "backfill_month_rows_tenant_batch_idx")
  @@map("backfill_month_rows")
}

model BackfillActivity {
  id              String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String               @map("tenant_id") @db.Uuid
  batchId         String               @map("batch_id") @db.Uuid
  monthRowId      String               @map("month_row_id") @db.Uuid
  activityType    BackfillActivityType @map("activity_type")
  activityDate    DateTime             @map("activity_date") @db.Date
  amount          Decimal              @db.Decimal(18, 2)
  direction       String               @default("credit")
  notes           String?
  metadata        Json?
  createdByUserId String?              @map("created_by_user_id") @db.Uuid
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  batch    BackfillBatch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  monthRow BackfillMonthRow @relation(fields: [monthRowId], references: [id], onDelete: Cascade)

  @@index([tenantId, batchId], map: "backfill_activities_tenant_batch_idx")
  @@index([monthRowId, activityDate], map: "backfill_activities_month_row_date_idx")
  @@map("backfill_activities")
}
