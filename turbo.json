{
  "$schema": "https://turborepo.org/schema.json",
  "globalDependencies": [
    ".env",
    ".env.local",
    ".env.dev",
    ".env.preview",
    ".env.production"
  ],
  "globalEnv": [
    "APP_ROOT_DOMAIN",
    "DASHBOARD_APP_URL",
    "HALAALVEST_DATABASE_URL",
    "EMAIL_DELIVERY_MODE",
    "EMAIL_FROM_ADDRESS",
    "EMAIL_QA_DOMAIN_ROUTES",
    "EMAIL_REPLY_TO",
    "EMAIL_TEST_RECIPIENT",
    "EMAIL_TEST_MODE",
    "EXPO_PUBLIC_API_URL",
    "EXPO_PUBLIC_APP_VARIANT",
    "EXPO_PUBLIC_DASHBOARD_URL",
    "APP_ENV",
    "AUTH_SECRET",
    "EXPO_PORT",
    "HALAALVEST_DB_MODE",
    "HALAALVEST_ENV_MODE",
    "HALAALVEST_DASHBOARD_PROD_PORT",
    "LOCAL_HOSTNAME",
    "DASHBOARD_ROOT_DOMAIN",
    "DASHBOARD_DEV_URL_VARIANT_HOSTS",
    "DASHBOARD_PORT",
    "LOCAL_DASHBOARD_PROXY_TARGET",
    "MARKETING_STAGE",
    "PLATFORM_APP_HOSTNAME",
    "PLATFORM_ROOT_DOMAIN",
    "RESEND_API_KEY",
    "SENTRY_DSN",
    "SIGNUP_TOKEN_SECRET",
    "LOCAL_ROOT_DOMAIN",
    "TENANT_ROOT_DOMAIN",
    "UPLOAD_DIR",
    "VERCEL_API_TOKEN",
    "VERCEL_ENV",
    "VERCEL_PROJECT_ID",
    "VERCEL_TEAM_ID",
    "VERCEL_TEAM_SLUG",
    "WEB_APP_ROOT_DOMAIN",
    "MARKETING_PORT",
    "WEB_PORTLESS_ROOT_DOMAIN",
    "MONTHLY_RECORD_CRON_ACTOR_USER_ID",
    "MONTHLY_RECORD_CRON_SECRET",
    "NODE_ENV",
    "NEXT_PUBLIC_SENTRY_DSN",
    "PORT",
    "PORTLESS_APP_PORT",
    "SHOW_HOME_PAGE",
    "TENANT_SITE_APP_URL",
    "TENANT_URL_PROJECT_SLUG",
    "TEST_DATABASE_URL",
    "TEST_EMAIL",
    "TZ"
  ],
  "ui": "tui",
  "tasks": {
    "topo": {
      "dependsOn": ["^topo"]
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        ".expo/**",
        "dist/**",
        "generated/**",
        "build/**",
        "lib/**",
        "next-env.d.ts"
      ]
    },
    "lint": {
      "dependsOn": ["^topo"]
    },
    "format": {
      "dependsOn": ["^format"]
    },
    "typecheck": {
      "outputs": []
    },
    "db:generate": {
      "cache": false,
      "outputs": ["generated/**"]
    },
    "dev": {
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "cache": false,
      "persistent": true
    },
    "dev:prod": {
      "cache": false,
      "persistent": true
    },
    "jobs": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "cache": false
    },
    "test": {
      "cache": false
    }
  }
}
