{
  "name": "@halaalvest/dashboard",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --env-file=/dev/null ../../../local-infra-kit/bin/with-env.ts --profile halaalvest -- PORTLESS_WILDCARD=1 PORTLESS_APP_PORT=${PORTLESS_APP_PORT:-${DASHBOARD_PORT:-1441}} TZ=UTC portless halaalvest-dash next dev --turbopack",
    "dev:prod": "bun --env-file=/dev/null ../../../local-infra-kit/bin/with-env.ts --profile halaalvest --mode prod -- next dev --turbopack -p ${HALAALVEST_DASHBOARD_PROD_PORT:-1445}",
    "build": "bun next build --turbopack",
    "start": "bun --env-file=/dev/null ../../../local-infra-kit/bin/with-env.ts --profile halaalvest --mode prod -- next start",
    "with-env": "bun --env-file=/dev/null ../../../local-infra-kit/bin/with-env.ts --profile halaalvest --",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@halaalvest/api": "workspace:*",
    "@halaalvest/auth": "workspace:*",
    "@halaalvest/backfill": "workspace:*",
    "@halaalvest/db": "workspace:*",
    "@halaalvest/domain": "workspace:*",
    "@halaalvest/errors": "workspace:*",
    "@halaalvest/jobs": "workspace:*",
    "@halaalvest/notifications": "workspace:*",
    "@halaalvest/notifications-react": "workspace:*",
    "@halaalvest/observability": "workspace:*",
    "@halaalvest/site-nav": "workspace:*",
    "@halaalvest/tenant-url": "workspace:*",
    "@halaalvest/ui": "workspace:*",
    "@halaalvest/utils": "workspace:*",
    "@hugeicons/core-free-icons": "^4.1.1",
    "@hugeicons/react": "^1.1.6",
    "@sentry/nextjs": "10.32.1",
    "@tanstack/react-query": "^5.100.14",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.23",
    "@trpc/client": "^11.18.0",
    "@trpc/server": "^11.18.0",
    "@trpc/tanstack-react-query": "^11.18.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.21.0",
    "next": "16.3.0",
    "next-themes": "^0.4.6",
    "nuqs": "^2.7.2",
    "react": "19.2.7",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.7",
    "react-hook-form": "^7.65.0",
    "react-hotkeys-hook": "^5.2.4",
    "superjson": "^2.2.2",
    "tailwind-merge": "^3.6.0",
    "xlsx": "^0.18.5",
    "zod": "^4.1.11",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@halaalvest/eslint-config": "workspace:^",
    "@halaalvest/tsconfig": "workspace:*",
    "@tailwindcss/postcss": "4.1.18",
    "@types/bun": "^1.3.14",
    "@types/node": "^25.1.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "^9.39.2",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3"
  }
}
