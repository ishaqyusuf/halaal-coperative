{
  "name": "halaalvest",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "bun --env-file=/dev/null scripts/local-infra-command.ts with-env --mode prod -- turbo build",
    "db:docker:down": "docker compose -f docker-compose.yml down",
    "db:docker:up": "bun run dev:services:local",
    "db:generate": "bun scripts/db-command.ts generate",
    "db:generate:dev": "bun scripts/db-command.ts generate --remote",
    "db:generate:local": "bun scripts/db-command.ts generate --local",
    "db:generate:prod": "bun scripts/db-command.ts generate --prod",
    "db:migrate": "bun scripts/db-command.ts migrate",
    "db:migrate:deploy": "bun scripts/db-command.ts deploy",
    "db:migrate:dev": "bun scripts/db-command.ts migrate --remote",
    "db:migrate:local": "bun scripts/db-command.ts migrate --local",
    "db:migrate:prod": "bun scripts/db-command.ts migrate --prod",
    "db:pull": "bun scripts/db-command.ts pull",
    "db:pull:dev": "bun scripts/db-command.ts pull --remote",
    "db:pull:local": "bun scripts/db-command.ts pull --local",
    "db:pull:prod": "bun scripts/db-command.ts pull --prod",
    "db:push": "bun scripts/db-push.ts",
    "db:push:dev": "bun scripts/db-push.ts --remote",
    "db:push:local": "bun scripts/db-push.ts --local",
    "db:push:prod": "bun scripts/db-push.ts --prod",
    "db:shell": "bun scripts/db-command.ts shell",
    "db:shell:dev": "bun scripts/db-command.ts shell --remote",
    "db:shell:local": "bun scripts/db-command.ts shell --local",
    "db:shell:prod": "bun scripts/db-command.ts shell --prod",
    "db:start": "bun run dev:services:local",
    "db:studio": "bun scripts/db-command.ts studio",
    "db:studio:dev": "bun scripts/db-command.ts studio --remote",
    "db:studio:local": "bun scripts/db-command.ts studio --local",
    "db:studio:prod": "bun scripts/db-command.ts studio --prod",
    "dev": "bun --env-file=/dev/null scripts/local-infra-command.ts dev",
    "dev:prepare": "bun run kill:ports && bun run dev:services",
    "dev:services": "bun --env-file=/dev/null scripts/local-infra-command.ts dev-services",
    "dev:services:local": "bun --env-file=/dev/null scripts/local-infra-command.ts dev-services --mode local",
    "dev:services:local-db": "bun --env-file=/dev/null scripts/local-infra-command.ts dev-services --mode local",
    "eas-build:dev": "bun --env-file=/dev/null ./scripts/eas-account-runner.ts eas-build:dev",
    "eas-build:preview": "bun --env-file=/dev/null ./scripts/eas-account-runner.ts eas-build:preview",
    "eas-update:preview": "bun --env-file=/dev/null ./scripts/eas-account-runner.ts update:preview",
    "jobs:deploy": "bun run --filter @halaalvest/jobs deploy",
    "kill:ports": "bun --env-file=/dev/null ../local-infra-kit/bin/kill-ports.ts --profile halaalvest",
    "lint": "turbo lint",
    "lint:mobile": "turbo lint --filter=@halaalvest/mobile",
    "format": "turbo format",
    "terminal": "bash ./scripts/open-bun-script-terminal.sh",
    "typecheck": "turbo typecheck",
    "typecheck:mobile": "turbo typecheck --filter=@halaalvest/mobile",
    "test": "turbo test"
  },
  "devDependencies": {
    "@halaalvest/eslint-config": "workspace:*",
    "@halaalvest/tsconfig": "workspace:*",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "turbo": "^2.8.17",
    "typescript": "5.9.3"
  },
  "packageManager": "bun@1.3.0",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "lightningcss": "1.30.1"
  }
}
