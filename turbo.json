    "PRODUCTION_QA_ANDROID_EVIDENCE_DIRECTORY",
    "PRODUCTION_QA_ANDROID_EXERCISE_DRAFT",
    "PRODUCTION_QA_ANDROID_EXERCISE_INPUTS",
    "PRODUCTION_QA_ANDROID_INSPECT_FOOTER",
    "PRODUCTION_QA_ANDROID_PRESENTATION_ONLY",
    "PRODUCTION_QA_ANDROID_ACCESSIBILITY_MATRIX",
    "PRODUCTION_QA_ANDROID_LAUNCH_URL",
    "PRODUCTION_QA_ANDROID_PACKAGE",
    "PRODUCTION_QA_ANDROID_SERIAL",
    "PRODUCTION_QA_EVIDENCE_DIRECTORY",
    "PRODUCTION_QA_INVITATION_CONFIRM",
    "PRODUCTION_QA_RUN_ID",
    "QA_ACCELERATOR_CLIENT_KINDS",
    "QA_ACCELERATOR_ENABLED",
    "QA_ACCELERATOR_SECRET",
    "QA_ACCELERATOR_TESTER_CREDENTIAL",
    "RESEND_API_KEY",
    "SENTRY_AUTH_TOKEN",
    "SENTRY_ORG",
    "SENTRY_DSN_API",
    "SENTRY_ENVIRONMENT_API",
    "SENTRY_PROJECT_API",
    "SENTRY_RELEASE_API",
    "SENTRY_DSN_DASHBOARD",
    "SENTRY_ENVIRONMENT_DASHBOARD",
    "SENTRY_PROJECT_DASHBOARD",
    "SENTRY_RELEASE_DASHBOARD",
    "SENTRY_DSN_MARKETING",
    "SENTRY_ENVIRONMENT_MARKETING",
    "SENTRY_PROJECT_MARKETING",
    "SENTRY_RELEASE_MARKETING",
    "SENTRY_DSN_JOBS",
    "SENTRY_ENVIRONMENT_JOBS",
    "SENTRY_PROJECT_JOBS",
    "SENTRY_RELEASE_JOBS",
    "SENTRY_PROJECT_MOBILE",
    "SENTRY_DISABLE_AUTO_UPLOAD",
    "SIGNUP_TOKEN_SECRET",
    "LOCAL_ROOT_DOMAIN",
    "TENANT_ROOT_DOMAIN",
    "UPLOAD_DIR",
    "VERCEL_API_TOKEN",
    "VERCEL_ENV",
    "VERCEL_PROJECT_ID",
    "VERCEL_TEAM_ID",
    "VERCEL_TEAM_SLUG",
    "WEB_APP_ROOT_DOMAIN",
    "MARKETING_PORT",
    "WEB_PORTLESS_ROOT_DOMAIN",
    "MONTHLY_RECORD_CRON_ACTOR_USER_ID",
    "MONTHLY_RECORD_CRON_SECRET",
    "NODE_ENV",
    "NEXT_RUNTIME",
    "NEXT_PUBLIC_SENTRY_DSN_DASHBOARD",
    "NEXT_PUBLIC_SENTRY_ENVIRONMENT_DASHBOARD",
    "NEXT_PUBLIC_SENTRY_RELEASE_DASHBOARD",
    "NEXT_PUBLIC_SENTRY_DSN_MARKETING",
    "NEXT_PUBLIC_SENTRY_ENVIRONMENT_MARKETING",
    "NEXT_PUBLIC_SENTRY_RELEASE_MARKETING",
    "EXPO_PUBLIC_SENTRY_DSN_MOBILE",
    "EXPO_PUBLIC_SENTRY_ENABLED_MOBILE",
    "EXPO_PUBLIC_SENTRY_ENVIRONMENT_MOBILE",
    "EXPO_PUBLIC_SENTRY_RELEASE_MOBILE",
    "EXPO_PUBLIC_SENTRY_SMOKE_TEST_MOBILE",
    "PORT",
    "PORTLESS_APP_PORT",
    "SHOW_HOME_PAGE",
    "STORE_BILLING_ENVIRONMENT",
    "STORE_BILLING_CATALOG",
    "STORE_BILLING_SALES_ENABLED",
    "MOBILE_APP_BILLING_CATALOG",
    "MOBILE_APP_BILLING_SALES_ENABLED",
    "STORE_REFUND_REVIEW_ACTIVE_KEY_ID",
    "STORE_REFUND_REVIEW_KEYS_JSON",
    "TENANT_SITE_APP_URL",
    "TENANT_URL_PROJECT_SLUG",
    "TEST_DATABASE_URL",
    "TEST_EMAIL",
    "TRIGGER_PROJECT_ID",
    "TZ",
    "NEXT_PUBLIC_LOGLY_ENABLED_DASHBOARD",
    "NEXT_PUBLIC_LOGLY_PROJECT_DASHBOARD",
    "NEXT_PUBLIC_LOGLY_ENABLED_MARKETING",
    "NEXT_PUBLIC_LOGLY_PROJECT_MARKETING",
    "LOGLY_COLLECTOR_URL",
    "LOGLY_DASHBOARD_PROJECT_KEY",
    "LOGLY_MARKETING_PROJECT_KEY",
    "LOGLY_DASHBOARD_ALLOWED_ORIGINS",
    "LOGLY_MARKETING_ALLOWED_ORIGINS",
    "LOGLY_MOBILE_PROJECT_KEY",
    "LOGLY_MOBILE_ORIGIN",
    "EXPO_PUBLIC_LOGLY_ENABLED",
    "EXPO_PUBLIC_LOGLY_ENDPOINT",
    "EXPO_PUBLIC_LOGLY_PROJECT"
  ],
  "ui": "tui",
  "tasks": {
    "topo": {
      "dependsOn": [
        "^topo"
      ]
    },
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        ".expo/**",
        "dist/**",
        "generated/**",
        "build/**",
        "lib/**",
        "next-env.d.ts"
      ]
    },
    "lint": {
      "dependsOn": [
        "^topo"
      ]
    },
    "format": {
      "dependsOn": [
        "^format"
      ]
    },
    "typecheck": {
      "outputs": []
    },
    "db:generate": {
      "cache": false,
      "outputs": [
        "generated/**"
      ]
    },
    "dev": {
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "cache": false,
      "persistent": true
    },
    "dev:prod": {
      "cache": false,
      "persistent": true
    },
    "jobs": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "cache": false
    },
    "test": {
      "cache": false
    }
  }
}
