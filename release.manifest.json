{
  "version": 1,
  "project": "halaalvest",
  "targets": [
    {
      "id": "database",
      "kind": "database",
      "environments": ["preview", "production"],
      "sourcePaths": [
        "packages/db/prisma/**/*.prisma",
        "packages/db/prisma.config.ts"
      ],
      "impactTargets": ["dashboard-web", "marketing-web", "jobs"]
    },
    {
      "id": "dashboard-web",
      "kind": "web",
      "environments": ["preview", "production"],
      "sourcePaths": [
        "apps/dashboard/**",
        "apps/api/**",
        "packages/auth/**",
        "packages/backfill/**",
        "packages/db/**",
        "packages/domain/**",
        "packages/email/**",
        "packages/errors/**",
        "packages/events/**",
        "packages/jobs/**",
        "packages/notifications/**",
        "packages/notifications-react/**",
        "packages/observability/**",
        "packages/site-nav/**",
        "packages/tenant-url/**",
        "packages/ui/**",
        "packages/utils/**",
        "package.json",
        "bun.lock",
        "turbo.json"
      ],
      "prerequisites": ["database"]
    },
    {
      "id": "marketing-web",
      "kind": "web",
      "environments": ["preview", "production"],
      "sourcePaths": [
        "apps/marketing/**",
        "apps/api/**",
        "packages/db/**",
        "packages/domain/**",
        "packages/email/**",
        "packages/errors/**",
        "packages/events/**",
        "packages/jobs/**",
        "packages/notifications/**",
        "packages/notifications-react/**",
        "packages/observability/**",
        "packages/tenant-url/**",
        "packages/ui/**",
        "packages/utils/**",
        "package.json",
        "bun.lock",
        "turbo.json"
      ],
      "prerequisites": ["database"]
    },
    {
      "id": "mobile",
      "kind": "mobile",
      "environments": ["preview", "production"],
      "sourcePaths": [
        "apps/mobile/**",
        "apps/api/**",
        "packages/domain/**",
        "packages/errors/**",
        "packages/events/**",
        "packages/observability/**",
        "packages/utils/**",
        "scripts/eas-account-runner.ts",
        "scripts/eas-android-artifact-preflight.ts",
        "scripts/eas-ios-artifact-preflight.ts",
        "scripts/eas-build-submission-guard.ts",
        "scripts/mobile-artifact-origins.ts",
        "scripts/public-pages-preflight.ts",
        "scripts/release-source-preflight.ts",
        "package.json",
        "bun.lock",
        "turbo.json"
      ],
      "nativeCandidatePaths": [
        "apps/mobile/app.config.ts",
        "apps/mobile/eas.json",
        "apps/mobile/mobile-release-env.js",
        "apps/mobile/release-version.ts",
        "apps/mobile/package.json",
        "apps/mobile/plugins/**",
        "apps/mobile/android/**",
        "apps/mobile/ios/**",
        "scripts/eas-account-runner.ts",
        "scripts/eas-android-artifact-preflight.ts",
        "scripts/eas-ios-artifact-preflight.ts",
        "scripts/eas-build-submission-guard.ts",
        "package.json",
        "bun.lock",
        "patches/**"
      ],
      "prerequisites": ["dashboard-web"]
    },
    {
      "id": "jobs",
      "kind": "jobs",
      "environments": ["preview", "production"],
      "sourcePaths": [
        "packages/jobs/**",
        "packages/backfill/**",
        "packages/db/**",
        "packages/domain/**",
        "packages/email/**",
        "packages/errors/**",
        "packages/notifications/**",
        "packages/observability/**",
        "packages/utils/**",
        "scripts/with-trigger-profile.mjs",
        "package.json",
        "bun.lock",
        "turbo.json"
      ],
      "prerequisites": ["database"]
    }
  ]
}
