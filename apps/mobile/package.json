{
  "name": "@halaalvest/mobile",
  "main": "expo-router/entry",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "bun run with-env node ./scripts/run-expo-cli.cjs run:android",
    "check:architecture": "node ./scripts/check-mobile-architecture.mjs",
    "check:contract": "bun run check:architecture && bun run check:runtime && bun run check:native-imports && bun run check:nativewind-theme-vars && bun run check:nativewind-ui && bun run check:keyboard && bun run check:dev-fixtures && bun run check:smoke",
    "check:dev-fixtures": "node ./scripts/check-dev-fixtures.mjs",
    "check:keyboard": "node ./scripts/check-keyboard-coverage.mjs",
    "check:native-imports": "node ./scripts/check-native-imports.mjs",
    "check:nativewind-ui": "node ./scripts/check-mobile-ui-contract.mjs",
    "check:runtime": "node ./scripts/check-mobile-runtime.mjs",
    "check:nativewind-theme-vars": "node ./scripts/check-nativewind-theme-vars.mjs",
    "check:smoke": "node ./scripts/check-smoke-coverage.mjs",
    "dev": "bun run with-env node ./scripts/run-expo-cli.cjs start --port ${EXPO_PORT:-1443}",
    "eas-build:dev": "bun --env-file=/dev/null ../../scripts/eas-account-runner.ts build --dev",
    "eas-build:preview": "bun --env-file=/dev/null ../../scripts/eas-account-runner.ts build --preview",
    "eas:update": "bun --env-file=/dev/null ../../scripts/eas-account-runner.ts update",
    "ios": "bun run with-env node ./scripts/run-expo-cli.cjs run:ios",
    "lint": "eslint .",
    "start": "bun run dev",
    "typecheck": "tsc --noEmit",
    "web": "bun run with-env node ./scripts/run-expo-cli.cjs start --web",
    "with-env": "bun --env-file=/dev/null ../../../local-infra-kit/bin/with-env.ts --profile halaalvest --",
    "with-env:prod": "bun --env-file=/dev/null ../../../local-infra-kit/bin/with-env.ts --profile halaalvest --mode prod --",
    "eas:update:prepare": "node ./scripts/eas-update.mjs --prepare-only"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
