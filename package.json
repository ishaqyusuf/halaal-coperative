{
  "name": "halaalvest",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "db:generate": "node ./scripts/with-workspace-env.mjs bun run --cwd packages/db db:generate",
    "db:migrate": "bun run db:start && node ./scripts/with-workspace-env.mjs bun run --cwd packages/db db:migrate",
    "db:migrate:deploy": "node ./scripts/with-workspace-env.mjs bun run --cwd packages/db db:migrate:deploy",
    "db:push": "bun scripts/db-push.ts",
    "db:start": "node ./scripts/with-workspace-env.mjs sh ./scripts/start-dev-db.sh",
    "db:studio": "bun run db:start && node ./scripts/with-workspace-env.mjs bun run --cwd packages/db db:studio",
    "kill:ports": "node ./scripts/with-workspace-env.mjs sh ./scripts/kill-port.sh",
    "dev:prepare": "bun run kill:ports && bun run db:start && bun run db:generate && bun run db:migrate:deploy",
    "dev": "bun scripts/dev.ts",
    "jobs:deploy": "bun run --filter @halaalvest/jobs deploy",
    "lint": "turbo lint",
    "lint:mobile": "turbo lint --filter=@halaalvest/mobile",
    "format": "turbo format",
    "terminal": "bash ./scripts/open-bun-script-terminal.sh",
    "typecheck": "turbo typecheck",
    "typecheck:mobile": "turbo typecheck --filter=@halaalvest/mobile",
    "test": "turbo test"
  },
  "devDependencies": {
    "@halaalvest/eslint-config": "workspace:*",
    "@halaalvest/tsconfig": "workspace:*",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "turbo": "^2.8.17",
    "typescript": "5.9.3"
  },
  "packageManager": "bun@1.3.0",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
