# ── BILLING CHECKOUT LINKS ─────────────────────────────────────────
# Exact provider checkout hostnames, comma separated. Empty disables checkout links.
# Does not configure or activate a billing provider.
HALAALVEST_BILLING_CHECKOUT_HOSTS=

# ── API OBSERVABILITY ──────────────────────────────────────────────
# API diagnostics are enabled only when NODE_ENV and this environment are production.
SENTRY_DSN_API=
SENTRY_ENVIRONMENT_API=
SENTRY_RELEASE_API=

# ── SENTRY DEPLOYMENT ──────────────────────────────────────────────
SENTRY_PROJECT_API=
SENTRY_ORG=
# Private build secret; never expose it to application clients.
SENTRY_AUTH_TOKEN=
HALAALVEST_ENV=local
QA_ACCELERATOR_ENABLED=true
QA_ACCELERATOR_SECRET=replace-with-a-non-production-secret
QA_ACCELERATOR_TESTER_CREDENTIAL=replace-with-a-local-tester-credential
QA_ACCELERATOR_CLIENT_KINDS=mobile,web
HALAALVEST_MOBILE_URL_SCHEME=halaalvest

# Superseded tenant-tier native subscription catalog. No new tenant offers are
# served; keep empty and use MOBILE_APP_BILLING_CATALOG for personal app access.
# Server-only secrets; never use EXPO_PUBLIC_ for these values.
STORE_BILLING_ENVIRONMENT=
# Enable new Production store offers only after all six approved public pages
# are effective and their live URLs/support/deletion operations are verified.
# Existing purchase verification and restoration do not depend on this switch.
STORE_BILLING_SALES_ENABLED=false
# JSON array of {store, productId, planCode, basePlanId?}; Google requires basePlanId.
# planCode is starter, standard or growth. Never infer product identifiers from plan names.
STORE_BILLING_CATALOG=[]
# Separate personal app-access catalog for every mobile user. Keep empty until
# the Apple/Google products and exact store price points are approved.
# JSON: [{"store":"apple","productId":"...","duration":"six_months"|"annual"},
# {"store":"google","productId":"...","basePlanId":"...","duration":"six_months"|"annual"}]
MOBILE_APP_BILLING_CATALOG=[]
MOBILE_APP_BILLING_SALES_ENABLED=false
APPLE_APP_ID=
APPLE_IAP_KEY_ID=
APPLE_IAP_ISSUER_ID=
APPLE_IAP_PRIVATE_KEY=
# JSON array of base64 DER Apple root certificates from Apple PKI.
APPLE_ROOT_CERTIFICATES_BASE64=[]
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
GOOGLE_PLAY_NOTIFICATION_AUDIENCE=
GOOGLE_PLAY_NOTIFICATION_SERVICE_EMAIL=
# Required before receiving pending-refund RTDNs: JSON map of key IDs to
# base64-encoded 32-byte AES keys, plus the active key ID. Keep old keys until
# every receipt encrypted under them is resolved and purged.
STORE_REFUND_REVIEW_KEYS_JSON=
STORE_REFUND_REVIEW_ACTIVE_KEY_ID=
