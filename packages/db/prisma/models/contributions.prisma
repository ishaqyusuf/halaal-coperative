model ContributionPlan {
  id                    String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId              String                   @map("tenant_id") @db.Uuid
  memberId              String                   @map("member_id") @db.Uuid
  name                  String
  amount                Decimal                  @db.Decimal(18, 2)
  interval              ContributionPlanInterval @default(monthly)
  startsAt              DateTime                 @map("starts_at") @db.Timestamptz(6)
  endsAt                DateTime?                @map("ends_at") @db.Timestamptz(6)
  isActive              Boolean                  @default(true) @map("is_active")
  createdAt             DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant                Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  member                Member                   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  contributions         Contribution[]

  @@index([tenantId, memberId], map: "contribution_plans_tenant_member_idx")
  @@map("contribution_plans")
}

model Contribution {
  id                    String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId              String             @map("tenant_id") @db.Uuid
  memberId              String             @map("member_id") @db.Uuid
  contributionPlanId    String?            @map("contribution_plan_id") @db.Uuid
  postedAt              DateTime           @map("posted_at") @db.Timestamptz(6)
  amount                Decimal            @db.Decimal(18, 2)
  committedAmount       Decimal?           @map("committed_amount") @db.Decimal(18, 2)
  extraSavingsAmount    Decimal            @default(0) @map("extra_savings_amount") @db.Decimal(18, 2)
  status                ContributionStatus @default(posted)
  channel               ContributionChannel
  periodLabel           String?            @map("period_label")
  reference             String?            @map("reference")
  notes                 String?
  createdAt             DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant                Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  member                Member             @relation(fields: [memberId], references: [id], onDelete: Cascade)
  contributionPlan      ContributionPlan?  @relation(fields: [contributionPlanId], references: [id], onDelete: SetNull)
  chargeApplication     ChargeApplication?
  ledgerTransaction     LedgerTransaction?

  @@index([tenantId, memberId, postedAt], map: "contributions_tenant_member_posted_at_idx")
  @@index([tenantId, status], map: "contributions_tenant_status_idx")
  @@map("contributions")
}
