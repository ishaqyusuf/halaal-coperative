    "APP_ROOT_DOMAIN",
    "DASHBOARD_APP_URL",
    "HALAALVEST_DATABASE_URL",
    "HALAALVEST_MOBILE_URL_SCHEME",
    "EMAIL_DELIVERY_MODE",
    "EMAIL_FROM_ADDRESS",
    "EMAIL_QA_DOMAIN_ROUTES",
