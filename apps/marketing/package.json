{
  "name": "@halaalvest/marketing",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "node ../../scripts/with-workspace-env.mjs PORTLESS_WILDCARD=1 PORTLESS_HTTPS=0 PORTLESS_APP_PORT=${PORTLESS_APP_PORT:-1440} TZ=UTC portless halaalvest next dev --turbopack",
    "build": "bun next build --turbopack",
    "start": "node ../../scripts/with-workspace-env.mjs next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@faker-js/faker": "^10.5.0",
    "@halaalvest/db": "workspace:*",
    "@halaalvest/domain": "workspace:*",
    "@halaalvest/jobs": "workspace:*",
    "@halaalvest/notifications": "workspace:*",
    "@halaalvest/notifications-react": "workspace:*",
    "@halaalvest/tenant-url": "workspace:*",
    "@halaalvest/ui": "workspace:*",
    "@halaalvest/utils": "workspace:*",
    "@hookform/resolvers": "^5.2.2",
    "lucide-react": "^1.21.0",
    "next": "16.2.9",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-hook-form": "^7.65.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.18",
    "@types/bun": "^1.3.14",
    "@types/node": "^25.1.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@halaalvest/eslint-config": "workspace:^",
    "@halaalvest/tsconfig": "workspace:*",
    "eslint": "^9.39.2",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3"
  }
}
