{
  "name": "@halaalvest/web",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "node ../../scripts/with-workspace-env.mjs PORTLESS_APP_PORT=${PORTLESS_APP_PORT:-1440} TZ=UTC portless halaalvest next dev --turbopack",
    "dev:portless": "node ../../scripts/with-workspace-env.mjs portless halaalvest next dev --turbopack",
    "build": "node ../../scripts/with-workspace-env.mjs next build --webpack",
    "start": "node ../../scripts/with-workspace-env.mjs next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@halaalvest/db": "workspace:*",
    "@halaalvest/domain": "workspace:*",
    "@halaalvest/notifications": "workspace:*",
    "@halaalvest/notifications-react": "workspace:*",
    "@halaalvest/ui": "workspace:*",
    "@halaalvest/utils": "workspace:*",
    "@hookform/resolvers": "^5.2.2",
    "next": "16.1.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.65.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^25.1.0",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@halaalvest/eslint-config": "workspace:^",
    "@halaalvest/tsconfig": "workspace:*",
    "eslint": "^9.39.2",
    "typescript": "^5.9.3"
  }
}
