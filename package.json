{
  "name": "halaal-vest",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "db:generate": "node ./scripts/with-workspace-env.mjs bun run --cwd packages/db db:generate",
    "db:migrate": "node ./scripts/with-workspace-env.mjs bun run --cwd packages/db db:migrate",
    "db:migrate:deploy": "node ./scripts/with-workspace-env.mjs bun run --cwd packages/db db:migrate:deploy",
    "db:studio": "node ./scripts/with-workspace-env.mjs bun run --cwd packages/db db:studio",
    "dev": "turbo dev --parallel",
    "dev:api": "turbo dev --filter=@halaal-vest/api",
    "dev:api:portless": "turbo dev:portless --filter=@halaal-vest/api",
    "dev:web": "turbo dev --filter=@halaal-vest/web",
    "dev:web:portless": "turbo dev:portless --filter=@halaal-vest/web",
    "dev:dashboard": "turbo dev --filter=@halaal-vest/dashboard",
    "dev:dashboard:portless": "turbo dev:portless --filter=@halaal-vest/dashboard",
    "dev:portless": "turbo dev:portless --parallel",
    "lint": "turbo lint",
    "format": "turbo format",
    "typecheck": "turbo typecheck",
    "test": "turbo test"
  },
  "devDependencies": {
    "@halaal-vest/eslint-config": "workspace:*",
    "@halaal-vest/tsconfig": "workspace:*",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "turbo": "^2.8.17",
    "typescript": "5.9.3"
  },
  "packageManager": "bun@1.3.0",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
